@model string

<div id="modal-eliminar" class="modal fade modal-sm" tabindex="-1" aria-labelledby="titulo-modal" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <div id="titulo-modal" class="modal-title fs-5">Alerta</div>
                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body justify-content-center align-items-center">
                <p id="pregunta" class="text-center"><strong class="text-danger">¿Eliminar @Model?</strong></p>
            </div>
            <div class="modal-footer justify-content-around">
                <button id="btn_si" class="btn btn-danger" :class="{ disabled: estaCargando }" type="button" @@click="eliminarCliente">&nbsp;&nbsp;SI&nbsp;&nbsp;</button>
                <button id="btn_no" class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">&nbsp;NO&nbsp;</button>
            </div>
        </div>
    </div>
</div>