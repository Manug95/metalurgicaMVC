@using metalurgicaMVC.ViewModels
@model ModalMensaje

@{
    string bsClass = Model.Tipo == TipoMensaje.SUCCESS ? "success" : (Model.Tipo == TipoMensaje.WARNING ? "warning" : "danger");
    string title = "";
    if (Model.Tipo == TipoMensaje.SUCCESS)
    {
        bsClass = "success";
        title = "Exito";
    }
    if (Model.Tipo == TipoMensaje.WARNING)
    {
        bsClass = "warning";
        title = "Advertencia";
    }
    if (Model.Tipo == TipoMensaje.ERROR)
    {
        bsClass = "danger";
        title = "Error";
    }
}

<div id="modal-mensaje" class="modal fade modal-md" tabindex="-1" aria-describedby="titulo-modal-mensaje" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <div id="titulo-modal-mensaje" class="modal-title fs-5">@title</div>
                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body justify-content-center align-items-center">
                <p id="mensaje" class="text-center text-@bsClass fw-bold fs-5">@Model.Mensaje</p>
            </div>
            <div class="modal-footer justify-content-center">
                <button class="btn btn-primary" type="button" data-bs-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>