<div id="modal-mensaje" class="modal fade modal-md" tabindex="-1" aria-describedby="titulo-modal-mensaje" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <div id="titulo-modal-mensaje" class="modal-title fs-5">{{ esMensajeError ? "Error" : "Mensaje" }}</div>
                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body justify-content-center align-items-center">
                <p 
                    id="mensaje" 
                    class="text-center fw-bold fs-5" 
                    :class="{ 'text-danger': esMensajeError, 'text-success': !esMensajeError }"
                >
                    {{ mensaje }}
                </p>
            </div>
            <div class="modal-footer justify-content-center">
                <button class="btn btn-primary" type="button" data-bs-dismiss="modal">&nbsp;&nbsp;OK&nbsp;&nbsp;</button>
            </div>
        </div>
    </div>
</div>