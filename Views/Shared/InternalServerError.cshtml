@model string?
@{
    ViewData["Title"] = "Error interno del servidor";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow border-0">
                <div class="card-body text-center p-5">

                    <div class="mb-4">
                        <i class="bi bi-x-octagon-fill text-danger"
                           style="font-size: 4rem;"></i>
                    </div>

                    <h1 class="display-6 fw-bold text-danger">
                        Error 500
                    </h1>

                    <h2 class="h4 mt-3">
                        Error interno del servidor
                    </h2>

                    <p class="lead text-muted mt-3">
                        Se ha producido un error inesperado al procesar tu solicitud.
                    </p>

                    <hr class="my-4" />

                    <p class="text-secondary">
                        Nuestro equipo ha sido notificado y está trabajando para resolver el problema.
                        Por favor, inténtalo de nuevo más tarde.
                    </p>

                    @if (!string.IsNullOrWhiteSpace(Model) && User.IsInRole("ADMIN"))
                    {
                        <div class="alert alert-secondary">
                            <strong>Id. de incidencia:</strong> @Model
                        </div>
                    }

                    <div class="d-flex justify-content-center gap-2 mt-4">
                        @* <a asp-controller="Home"
                           asp-action="Index"
                           class="btn btn-primary">
                            Ir al inicio
                        </a> *@

                        <button type="button"
                                class="btn btn-outline-secondary"
                                onclick="location.reload()">
                            Reintentar
                        </button>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>