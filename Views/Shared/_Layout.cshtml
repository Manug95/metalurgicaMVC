@using System.Security.Claims
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - metalurgicaMVC</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/metalurgicaMVC.styles.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
</head>
<body class="d-flex flex-column min-vh-100">
    @{
        var user = User;
        var indentity = user?.Identity;
    }
    @if(indentity != null && indentity.IsAuthenticated) 
    {
        <header class="position-sticky top-0 z-3">
            <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light border-bottom box-shadow p-0 fs-5" style="background-color: #fdebe3">
                <div class="container-fluid">
                    <span class="fs-3 nav-font">Metalurgica</span>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                            aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="ms-1 navbar-collapse collapse d-sm-inline-flex justify-content-between">
                        @{
                            string linkActivo = ViewBag.linkActivo;
                        }
                        <ul class="navbar-nav flex-grow-1">
                            @* <li class="nav-item@(linkActivo == "home" ? " active-link" : "")">
                                <a class="nav-link text-dark nav-font" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                            </li> *@
                            <li class="nav-item@(linkActivo == "clientes" ? " active-link" : "")">
                                <a class="nav-link text-dark nav-font" asp-area="" asp-controller="Cliente" asp-action="Index">Clientes</a>
                            </li>
                            @* <li class="nav-item@(linkActivo == "trabajos" ? " active-link" : "")">
                                <a class="nav-link text-dark nav-font" asp-area="" asp-controller="Trabajo" asp-action="Index">Trabajos</a>
                            </li> *@
                            <li class="nav-item dropdown @(ViewBag?.linkActivo == "trabajos" ? "active-link" : "")">
                                <a class="nav-link dropdown-toggle text-dark nav-font" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Trabajos
                                </a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item text-dark nav-font" asp-area="" asp-controller="Trabajo" asp-action="Index">Ver Listado</a></li>
                                    <li><a class="dropdown-item text-dark nav-font" asp-area="" asp-controller="Trabajo" asp-action="Create">Nuevo</a></li>
                                </ul>
                            </li>
                            <li class="nav-item@(linkActivo == "materiales" ? " active-link" : "")">
                                <a class="nav-link text-dark nav-font" asp-area="" asp-controller="Material" asp-action="Index">Materiales</a>
                            </li>
                            @if (User.IsInRole("ADMIN")) {
                                <li class="nav-item@(linkActivo == "tipoOperacion" ? " active-link" : "")">
                                    <a class="nav-link text-dark nav-font" asp-area="" asp-controller="TipoOperacion" asp-action="Index">Tipos de Operación</a>
                                </li>
                                <li class="nav-item@(linkActivo == "usuarios" ? " active-link" : "")">
                                    <a class="nav-link text-dark nav-font" asp-area="" asp-controller="Usuario" asp-action="Index">Usuarios</a>
                                </li>
                            }
                        </ul>
                        <div class="dropdown" style="background-color: #ffc2a7">
                            <button class="btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                @{
                                    string? avatarURL = user?.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Uri)?.Value;
                                    string username = indentity?.Name ?? "Usuario";
                                }
                                <span class="pe-3 ps-1 fs-5 nav-font">@username</span>
                                @if (avatarURL != null && avatarURL.Length > 0) {
                                    <img width="32" src="@avatarURL" alt="" class="rounded-circle" asp-append-version="true" >
                                } else {
                                    <img width="32" src="https://ui-avatars.com/api/?name=@(username)&background=random&rounded=true" alt="" asp-append-version="true" >
                                }
                            </button>
                            <ul class="dropdown-menu">
                                <li><span class="dropdown-item">@(User.Claims.FirstOrDefault(c => c.Type == "FullName")?.Value ?? "nombre completo")</span></li>
                                <li><hr class="dropdown-divider"></li>
                                @{string? id = User.Claims.FirstOrDefault(c => c.Type == "id")?.Value;}
                                <li><a class="dropdown-item nav-font" asp-area="" asp-controller="Usuario" asp-action="Edit" asp-route-id="@id">Actualizar Perfil</a></li>
                                <li><a class="dropdown-item nav-font" asp-area="" asp-controller="Usuario" asp-action="Logout">Salir</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </nav>
        </header>
    }
    <div class="container-fluid flex-grow-1">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top text-light-emphasis align-middle mt-auto" style="background-color: #fdebe3; height: 5vh;">
        <div class="container h-100 d-flex justify-content-start align-items-center">
            <span>&copy; 2026 - metalurgicaMVC - Gutierrez Manuel</span>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
