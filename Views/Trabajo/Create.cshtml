@using System.Text.Json
@using metalurgicaMVC.ViewModels
@model FormTrabajoVM

@{
    ViewData["Title"] = "Trabajo";
    var serializationOptions = new JsonSerializerOptions {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase
    };
}

<div id="app" class="container" v-cloak>
    <div class="row border rounded-4 p-3 mt-2">
        <div class="col-12 col-md-6 col-lg mt-2 mt-lg-0 position-relative">
            <label for="" class="form-label fw-bold">Cliente</label>
            <!-- Input Group con ícono y campo de búsqueda -->
            <div class="input-group mb-3">
                <!-- Ícono de Lupa (Bootstrap Icons) -->
                <span class="input-group-text bg-transparent border-end-0">
                    <i class="bi bi-search text-muted"></i>
                </span>
                
                <!-- Campo de entrada -->
                <input 
                    type="search" 
                    id="searchInput" 
                    class="form-control border-start-0 ps-0" 
                    placeholder="Buscar..." 
                    aria-label="Buscar"
                    v-model="search"
                    @@input="searchInputListener"
                    @@focus="mostrarItemsClientes(true)"
                    @@focusOut="mostrarItemsClientes(false)"
                >

                <!-- Botón opcional para limpiar la búsqueda -->
                <button 
                    type="button" id="clearBtn" 
                    class="btn btn-outline-secondary d-none" 
                    :class="{ 'd-none': search.trim().length > 0 }"
                    @@click="limpiarSearch"
                    style="cursor: pointer;"
                >
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <!-- Contenedor o lista donde se muestran/filtran los resultados -->
            <div id="resultsList" class="list-group position-absolute z-3 overflow-y-auto w-100" v-show="itemsClientes.length > 0 && searchFocused" style="height: 8em;">
                <button 
                    type="button" 
                    class="list-group-item list-group-item-action search-item" 
                    :class="{ active: index == 0, selected: index == 0 }"
                    :autofocus="index == 0"
                    v-for="(c, index) in itemsClientes" :key="c.id"
                    @@click="seleccionarCliente(c)"
                >
                    {{ c.apellido + ", " + c.nombre }}
                </button>
            </div>
        </div>
        <div class="col-12 col-md-6 col-lg mt-3 mt-lg-0">
            <label for="" class="form-label fw-bold">Fecha Solicitado</label>
            <input type="date" class="form-control" v-model="trabajo.fechaSolicitado">
        </div>
    </div>

    <div class="row border rounded-4 p-3 mt-2">
        <div class="col-12 d-flex justify-content-between align-items-start">
            <h3 class="display-4">Detalle</h3>
            <button type="button" class="btn btn-danger mt-2 mt-md-0" @@click="borrarDetalle">Borrar Detalle</button>
        </div>
        <div class="col mt-1">
            <div class="accordion shadow-sm" id="accordionForms"> 
                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseChapas" aria-expanded="true" aria-controls="collapseChapas">
                            <strong>Chapas</strong>
                        </button>
                    </h2>
                    <div id="collapseChapas" class="accordion-collapse collapse show" data-bs-parent="#accordionForms">
                        <div class="accordion-body">
                            <div class="row">
                                <div class="col-12 col-md-6 col-lg">
                                    <label for="tipoOperacion" class="form-label fw-bold">Tipo Operación</label>
                                    <select id="tipoOperacion" class="form-select" :class="{ 'is-invalid': erroresDetalleChapa.tipoOperacion }" v-model="itemDetalle.tipoOperacion">
                                        <option value="" selected disabled>Seleccionar...</option>
                                        <option :value="to.id" v-for="to in tiposOperacion" :key="to.id">{{ to.nombre }}</option>
                                    </select>
                                    <div id="error_tipoOperacion" class="invalid-feedback" v-if="erroresDetalleChapa.tipoOperacion">{{ erroresDetalleChapa.tipoOperacion }}</div>
                                </div>
                                <div class="col-12 col-md-6 col-lg mt-3 mt-md-0">
                                    <label for="chapa" class="form-label fw-bold">Chapa</label>
                                    <select id="chapa" class="form-select" :class="{ 'is-invalid': erroresDetalleChapa.chapa }" v-model="itemDetalle.chapa">
                                        <option value="" selected disabled>Seleccionar...</option>
                                        <option :value="c.id" v-for="c in getChapas" :key="c.id">{{ c.descripcion }}</option>
                                    </select>
                                    <div id="error_chapa" class="invalid-feedback" v-if="erroresDetalleChapa.chapa">{{ erroresDetalleChapa.chapa }}</div>
                                </div>
                                <div class="col-12 col-md-6 col-lg mt-3 mt-lg-0">
                                    <label for="largo" class="form-label fw-bold">Largo (mm)</label>
                                    <input type="number" id="largo" class="form-control" :class="{ 'is-invalid': erroresDetalleChapa.largo }" v-model="itemDetalle.largo">
                                    <div id="error_largo" class="invalid-feedback" v-if="erroresDetalleChapa.largo">{{ erroresDetalleChapa.largo }}</div>
                                </div>
                                <div class="col-12 col-md-6 col-lg mt-3 mt-lg-0">
                                    <label for="ancho" class="form-label fw-bold">Ancho (mm)</label>
                                    <input type="number" id="ancho" class="form-control" :class="{ 'is-invalid': erroresDetalleChapa.ancho }" v-model="itemDetalle.ancho">
                                    <div id="error_ancho" class="invalid-feedback" v-if="erroresDetalleChapa.ancho">{{ erroresDetalleChapa.ancho }}</div>
                                </div>
                                <div class="col-12 col-md-6 col-lg mt-3 mt-lg-0">
                                    <label for="cantidad" class="form-label fw-bold">Cantidad</label>
                                    <input type="number" id="cantidad" class="form-control" :class="{ 'is-invalid': erroresDetalleChapa.cantidad }" v-model="itemDetalle.cantidad">
                                    <div id="error_cantidad" class="invalid-feedback" v-if="erroresDetalleChapa.cantidad">{{ erroresDetalleChapa.cantidad }}</div>
                                </div>
                                <div class="col-12 mt-4 d-flex justify-content-evenly">
                                    <button type="button" class="btn btn-secondary" @@click="limpiarInputsChapas">{{ getTextoBotonLimpiar }}</button>
                                    <button type="button" class="btn btn-primary" @@click="addItemChapas">{{ getTextoBotonAdd }}</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseCanios" aria-expanded="true" aria-controls="collapseCanios">
                            <strong>Caños Estructurales</strong>
                        </button>
                    </h2>
                    <div id="collapseCanios" class="accordion-collapse collapse" data-bs-parent="#accordionForms">
                        <div class="accordion-body">
                            <div class="row">
                                <div class="col-12 col-md-6 col-lg">
                                    <label for="canio" class="form-label fw-bold">Caño</label>
                                    <select id="canio" class="form-select" :class="{ 'is-invalid': erroresDetalleCanio.canio }" v-model="itemDetalle.canio">
                                        <option value="" selected disabled>Seleccionar...</option>
                                        <option :value="c.id" v-for="c in getCanios" :key="c.id">{{ c.descripcion }}</option>
                                    </select>
                                    <div id="error_canio" class="invalid-feedback" v-if="erroresDetalleCanio.canio">{{ erroresDetalleCanio.canio }}</div>
                                </div>
                                <div class="col-12 col-md-6 col-lg mt-3 mt-lg-0">
                                    <label for="largoCanio" class="form-label fw-bold">Largo</label>
                                    <input type="number" id="largoCanio" class="form-control" :class="{ 'is-invalid': erroresDetalleCanio.largoCanio }" v-model="itemDetalle.largoCanio">
                                    <div id="error_largoCanio" class="invalid-feedback" v-if="erroresDetalleCanio.largoCanio">{{ erroresDetalleCanio.largoCanio }}</div>
                                </div>
                                <div class="col-12 col-md-6 col-lg mt-3 mt-lg-0">
                                    <label for="cantidadCanios" class="form-label fw-bold">Cantidad</label>
                                    <input type="number" id="cantidadCanios" class="form-control" :class="{ 'is-invalid': erroresDetalleCanio.cantidadCanios }" v-model="itemDetalle.cantidadCanios">
                                    <div id="error_cantidadCanios" class="invalid-feedback" v-if="erroresDetalleCanio.cantidadCanios">{{ erroresDetalleCanio.cantidadCanios }}</div>
                                </div>
                                <div class="col-12 mt-4 d-flex justify-content-evenly">
                                    <button type="button" class="btn btn-secondary" @@click="limpiarInputsCanios">{{ getTextoBotonLimpiar }}</button>
                                    <button type="button" class="btn btn-primary" @@click="addItemCanio">{{ getTextoBotonAdd }}</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapsePintura" aria-expanded="true" aria-controls="collapsePintura">
                            <strong>Pintura</strong>
                        </button>
                    </h2>
                    <div id="collapsePintura" class="accordion-collapse collapse" data-bs-parent="#accordionForms">
                        <div class="accordion-body">
                            <div class="row">
                                <div class="col-12 col-md-6 col-lg">
                                    <label for="tipoPintura" class="form-label fw-bold">Tipo Pintura</label>
                                    <select id="tipoPintura" class="form-select" :class="{ 'is-invalid': erroresDetallePintura.tipoPintura }" v-model="itemDetalle.tipoPintura">
                                        <option value="" selected disabled>Seleccionar...</option>
                                        <option :value="p.id" v-for="p in getPinturas" :key="p.id">{{ p.descripcion }}</option>
                                    </select>
                                    <div id="error_tipoPintura" class="invalid-feedback" v-if="erroresDetallePintura.tipoPintura">{{ erroresDetallePintura.tipoPintura }}</div>
                                </div>
                                <div class="col-12 col-md-6 col-lg mt-3 mt-lg-0">
                                    <label for="color" class="form-label fw-bold">Color</label>
                                    <input type="text" id="color" class="form-control" :class="{ 'is-invalid': erroresDetallePintura.color }" v-model="itemDetalle.color">
                                    <div id="error_color" class="invalid-feedback" v-if="erroresDetallePintura.color">{{ erroresDetallePintura.color }}</div>
                                </div>
                                <div class="col-12 mt-4 d-flex justify-content-evenly">
                                    <button type="button" class="btn btn-secondary" @@click="limpiarInputsPintura">{{ getTextoBotonLimpiar }}</button>
                                    <button type="button" class="btn btn-primary" @@click="addItemPintura">{{ getTextoBotonAdd }}</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="row mt-4">
                <div class="col">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between align-items-center" v-for="(i, index) in listaDetalle" :key="i.id">
                            <span>
                                {{ mostrarItemDetalle(i) }}
                                <span>
                                    <i 
                                        class="bi bi-pencil-square text-primary icon-hover fs-5 ms-2 ms-md-3" 
                                        data-bs-toggle="tooltip" 
                                        data-bs-title="Editar" 
                                        :data-item="index"
                                        @@click="editarDetalle(i)"
                                    ></i>
                                    <i 
                                        class="bi bi-trash text-danger icon-hover fs-5 ms-2 ms-md-3" 
                                        data-bs-toggle="tooltip" 
                                        data-bs-title="Eliminar" 
                                        :data-item="index"
                                        @@click="eliminarDetalle(i, index)"
                                    ></i>
                                </span>
                            </span>
                            <span class="badge text-bg-primary rounded-pill" v-if="i.cantidad">{{ i.cantidad }}</span>
                            <span class="badge text-bg-primary rounded-pill" v-if="i.cantidadCanios">{{ i.cantidadCanios }}</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
        @* <div class="col-12 border-top pt-2 px-0"> 
            <ul class="list-group list-group-horizontal-lg">
                <li class="list-group-item fs-5">Cantidad de chapas estimada</li>
                <li class="list-group-item fs-5" v-for="(value, key) in cantidadesChapas">
                    {{ getTipoChapa(key) }}: {{ value }}
                </li>
            </ul>
        </div> *@
    </div>

    <div class="row border rounded-4 p-3 mt-2 mb-2">
        <div class="col-12 d-flex flex-row-reverse p-1">
            <span class="fs-4">Importe: $ {{ formatearImporte }}</span>
        </div>
        <div class="col-12 d-flex flex-row-reverse p-1">
            <span class="fs-4">IVA: $ {{ formatearIVA }}</span>
        </div>
        <div class="col-12 d-flex flex-row-reverse p-1">
            <span class="fs-4">Importe Total: $ {{ formatearImporteTotal }}</span>
        </div>
    </div>
    
</div>

@section Scripts {
    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
    <script>
        const { createApp } = Vue;
        @* const itemDetalleDefault = { id: 0, tipo: "", tipoOperacion: "", chapa: "", espesor: "", largo: 0, ancho: 0, cantidad: 0 }; *@
        const itemDetalleDefault = { id: 0, tipo: "", tipoOperacion: "", chapa: "", largo: 0, ancho: 0, cantidad: 0, canio: "", cantidadCanios: 0, largoCanio: 0, tipoPintura: "", color: "" };
        @* const itemDetalleDefault = { id: 4, tipo: "chapa", tipoOperacion: "Corte", chapa: "Chapa Acero al Carbono 14", largo: 1200, ancho: 560, cantidad: 3 }; *@
        const erroresDetalleChapaDefault = { tipoOperacion: null, chapa: null, largo: null, ancho: null, cantidad: null };
        const erroresDetalleCanioDefault = { largoCanio: null, canio: null, cantidadCanios: null };
        const erroresDetallePinturaDefault = { tipoPintura: null, color: null };
        const trabajoDefault = { id: 0, fechaSolicitado: null, clienteId: 0, detalle: [] };
        const importeDefault = { monto: 0, iva: 0, total: 0 };
        @* const cantidadesChapasDefault = { galvanizada: 0, Acarbono: 0, prepintada: 0 }; *@

        createApp({
            data() {
                return {
                    listaDetalle: [
                        @* { id: 1, tipo: "chapa", tipoOperacion: "Corte", chapa: "Chapa Acero al Carbono 14", largo: 1200, ancho: 560, cantidad: 3 },
                        { id: 2, tipo: "chapa", tipoOperacion: "Plegado", chapa: "Chapa Acero al Carbono 14", largo: 1200, ancho: 560, cantidad: 3 },
                        { id: 3, tipo: "chapa", tipoOperacion: "Cilindrado", chapa: "Chapa Acero al Carbono 16", largo: 850, ancho: 300, cantidad: 1 },
                        { id: 4, tipo: "pintura", tipoPintura: "Pintura", color: "negro" },
                        { id: 5, tipo: "caño", canio: "40x80x1.6", largoCanio: 3, cantidadCanios: 1 } *@
                    ],
                    itemDetalle: { ...itemDetalleDefault },
                    erroresDetalleChapa: { ...erroresDetalleChapaDefault },
                    erroresDetalleCanio: { ...erroresDetalleCanioDefault },
                    erroresDetallePintura: { ...erroresDetallePinturaDefault },
                    estaEditandoDetalle: false,
                    trabajo: { ...trabajoDefault },
                    search: "",
                    searchFocused: false,
                    itemsClientes: [],
                    timeout: null,
                    clienteSeleccionado: null,
                    importe: { ...importeDefault },
                    @* cantidadesChapas: { ...cantidadesChapasDefault }, *@
                    tooltipTriggerList: [],
                    tooltipList: [],
                    accordionCollapseElementList: [],
                    accordionCollapseList:[],
                    materiales: @Html.Raw(JsonSerializer.Serialize(Model.Materiales, serializationOptions)),
                    tiposOperacion: @Html.Raw(JsonSerializer.Serialize(Model.TipoOperaciones, serializationOptions)),
                    formateador: new Intl.NumberFormat('es-ES', { minimumFractionDigits: 2, maximumFractionDigits: 2 })
                }
            },
            methods: {
                limpiarInputsChapas() {
                    if (this.estaEditandoDetalle)
                        this.estaEditandoDetalle = false;
                    this.itemDetalle = { ...itemDetalleDefault };
                    this.erroresDetalleChapa = { ...erroresDetalleChapaDefault };
                },
                limpiarInputsCanios() {
                    if (this.estaEditandoDetalle)
                        this.estaEditandoDetalle = false;
                    this.itemDetalle = { ...itemDetalleDefault };
                    this.erroresDetalleCanio = { ...erroresDetalleCanioDefault };
                },
                limpiarInputsPintura() {
                    if (this.estaEditandoDetalle)
                        this.estaEditandoDetalle = false;
                    this.itemDetalle = { ...itemDetalleDefault };
                    this.erroresDetallePintura = { ...erroresDetallePinturaDefault };
                },
                limpiarSearch() {
                    this.search = "";
                    this.itemsClientes = [];
                    this.searchFocused = false;
                },
                addItemChapas() {
                    if (!this.esDetalleChapasValido())
                        return;
                    if (this.estaEditandoDetalle) {
                        const indiceItemEditado = this.listaDetalle.findIndex(d => d.id == this.itemDetalle.id);
                        if (indiceItemEditado >= 0)
                            this.listaDetalle[indiceItemEditado] = this.itemDetalle;
                        this.estaEditandoDetalle = false;
                        this.itemDetalle = { ...itemDetalleDefault };
                    } else {
                        const fechaActual = new Date();
                        this.itemDetalle.id = `${fechaActual.getTime()}`; // antes de guardar lo busco con typeof `${new Date().getTime()}` == "string" y lo seteo en 0
                        this.itemDetalle.tipo = "CHAPA";
                        this.listaDetalle.push(this.itemDetalle);
                        this.itemDetalle = { ...this.itemDetalle };
                        setTimeout(() => { this.inicializarTooltips(); }, 1000+(this.listaDetalle.length*100));
                    }
                    this.calcularPrecio();
                    @* this.calcularCantidadChapas(); *@
                },
                addItemCanio() {
                    if (!this.esDetalleCanioValido())
                        return;
                    if (this.estaEditandoDetalle) {
                        const indiceItemEditado = this.listaDetalle.findIndex(d => d.id == this.itemDetalle.id);
                        if (indiceItemEditado >= 0)
                            this.listaDetalle[indiceItemEditado] = this.itemDetalle;
                        this.estaEditandoDetalle = false;
                        this.itemDetalle = { ...itemDetalleDefault };
                    } else {
                        const fechaActual = new Date();
                        this.itemDetalle.id = `${fechaActual.getTime()}`; // antes de guardar lo busco con typeof `${new Date().getTime()}` == "string" y lo seteo en 0
                        this.itemDetalle.tipo = "CAÑO";
                        this.listaDetalle.push(this.itemDetalle);
                        this.itemDetalle = { ...this.itemDetalle };
                        setTimeout(() => { this.inicializarTooltips(); }, 1000+(this.listaDetalle.length*100));
                    }
                    // this.calcularPrecio();
                },
                addItemPintura() {
                    if (!this.esDetallePinturaValido())
                        return;
                    if (this.estaEditandoDetalle) {
                        const indiceItemEditado = this.listaDetalle.findIndex(d => d.id == this.itemDetalle.id);
                        if (indiceItemEditado >= 0)
                            this.listaDetalle[indiceItemEditado] = this.itemDetalle;
                        this.estaEditandoDetalle = false;
                        this.itemDetalle = { ...itemDetalleDefault };
                    } else {
                        const fechaActual = new Date();
                        this.itemDetalle.id = `${fechaActual.getTime()}`; // antes de guardar lo busco con typeof `${new Date().getTime()}` == "string" y lo seteo en 0
                        this.itemDetalle.tipo = "PINTURA";
                        this.listaDetalle.push(this.itemDetalle);
                        this.itemDetalle = { ...this.itemDetalle };
                        setTimeout(() => { this.inicializarTooltips(); }, 1000+(this.listaDetalle.length*100));
                    }
                    // this.calcularPrecio();
                },
                esDetalleChapasValido() {
                    const mapaValidador = new Map([
                        ["tipoOperacion", validarFormSelect],
                        ["chapa", validarFormSelect],
                        ["largo", validarInputNumber],
                        ["ancho", validarInputNumber],
                        ["cantidad", validarInputNumber]
                    ]);
                    const clavesAValidar = [...mapaValidador.keys()];
                    Object.keys(this.itemDetalle)
                        .forEach(key => {
                            if (!clavesAValidar.includes(key)) return;
                            this.erroresDetalleChapa[key] = mapaValidador.get(key)(this.itemDetalle[key]);
                        }
                    );
                    return !Object.keys(this.erroresDetalleChapa).some(v => this.erroresDetalleChapa[v]);
                },
                esDetalleCanioValido() {
                    const mapaValidador = new Map([
                        ["canio", validarFormSelect],
                        ["largoCanio", validarInputNumber],
                        ["cantidadCanios", validarInputNumber]
                    ]);
                    const clavesAValidar = [...mapaValidador.keys()];
                    Object.keys(this.itemDetalle)
                        .forEach(key => {
                            if (!clavesAValidar.includes(key)) return;
                            this.erroresDetalleCanio[key] = mapaValidador.get(key)(this.itemDetalle[key]);
                        }
                    );
                    return !Object.keys(this.erroresDetalleCanio).some(v => this.erroresDetalleCanio[v]);
                },
                esDetallePinturaValido() {
                    const mapaValidador = new Map([
                        ["tipoPintura", validarFormSelect]
                    ]);
                    const clavesAValidar = [...mapaValidador.keys()];
                    Object.keys(this.itemDetalle)
                        .forEach(key => {
                            if (!clavesAValidar.includes(key)) return;
                            this.erroresDetallePintura[key] = mapaValidador.get(key)(this.itemDetalle[key]);
                        }
                    );
                    return !Object.keys(this.erroresDetallePintura).some(v => this.erroresDetallePintura[v]);
                },
                editarDetalle(detalle) {
                    this.itemDetalle = { ...detalle };
                    this.estaEditandoDetalle = true;
                    if (detalle.tipo == "pintura") {
                        this.erroresDetallePintura = { ...erroresDetallePinturaDefault };
                        bootstrap.Collapse.getInstance(document.getElementById("collapseChapas")).hide();
                        bootstrap.Collapse.getInstance(document.getElementById("collapseCanios")).hide();
                        bootstrap.Collapse.getInstance(document.getElementById("collapsePintura")).show();
                        // this.accordionCollapseList.forEach(accordion => {
                        //     console.log(accordion);
                        // });
                    } else if (detalle.tipo == "CHAPA") {
                        this.erroresDetalleChapa = { ...erroresDetalleChapaDefault };
                        bootstrap.Collapse.getInstance(document.getElementById("collapseCanios")).hide();
                        bootstrap.Collapse.getInstance(document.getElementById("collapsePintura")).hide();
                        bootstrap.Collapse.getInstance(document.getElementById("collapseChapas")).show();
                    } else {
                        this.erroresDetalleCanio = { ...erroresDetalleCanioDefault };
                        bootstrap.Collapse.getInstance(document.getElementById("collapseChapas")).hide();
                        bootstrap.Collapse.getInstance(document.getElementById("collapsePintura")).hide();
                        bootstrap.Collapse.getInstance(document.getElementById("collapseCanios")).show();
                    }
                },
                eliminarDetalle(detalle, index) {
                    this.tooltipList = this.tooltipList.filter(tooltip => {
                        if (tooltip._element.dataset["item"] == index)
                            tooltip.dispose(); // esto hace que tooltip._element sea null
                        return tooltip._element; // si tooltip._element es null, ese tooltip se borro y no lo quiero en la lista
                    });
                    this.listaDetalle.splice(this.listaDetalle.findIndex(d => d == detalle), 1);
                    this.calcularPrecio();
                    @* this.calcularCantidadChapas(); *@
                },
                mostrarItemDetalle(item) {
                    if (item.tipo == "CHAPA") {
                        const chapa = this.materiales.find(m => m.id == item.chapa);
                        const tipoOperacion = this.tiposOperacion.find(to => to.id == item.tipoOperacion);
                        return `${tipoOperacion.nombre} en ${chapa.descripcion} ${item.largo} x ${item.ancho}`;
                    }
                    if (item.tipo == "PINTURA") {
                        const pintura = this.materiales.find(m => m.id == item.tipoPintura);
                        return `Pintado con ${pintura.descripcion}` + (item.color ? ` color ${item.color}` : "");
                    }
                    if (item.tipo == "CAÑO") {
                        const canio = this.materiales.find(m => m.id == item.canio);
                        return `${canio.descripcion} x ${item.largoCanio} mts`;
                    }
                    return "";
                },
                borrarDetalle() {
                    this.listaDetalle = [];
                    this.itemDetalle = { ...itemDetalleDefault };
                    this.importe = { ...importeDefault };
                    @* this.cantidadesChapas = { ...cantidadesChapasDefault }; *@
                },
                async searchInputListener(e) {
                    if (this.search.trim() == 0) {
                        this.itemsClientes = [];
                        return;
                    }
                    // Debounce: espera 300ms después de que el usuario deja de escribir
                    clearTimeout(this.timeout);
                    this.timeout = setTimeout(async () => {
                        if (this.search.trim() == 0)
                            return;
                        // Lógica de filtrado
                        try {
                            const response = await fetch(`/api/clientes?busqueda=${this.search}`);
                            const data = await response.json();
                            this.itemsClientes = data.clientes;
                        } catch (error) {
                            console.error("Error en la búsqueda:", error);
                        }
                    }, 300);
                },
                seleccionarCliente(c) {
                    this.clienteSeleccionado = c;
                },
                mostrarItemsClientes(valor) {
                    this.searchFocused = valor;
                },
                inicializarTooltips() {
                    this.tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]');
                    this.tooltipList = [...this.tooltipTriggerList].map(tooltipTriggerEl => new bootstrap.Tooltip(tooltipTriggerEl));
                },
                inicializarAccordion() {
                    this.accordionCollapseElementList = document.querySelectorAll('#accordionForms .collapse')
                    this.accordionCollapseList = [...this.accordionCollapseElementList].map(accordionCollapseEl => 
                        new bootstrap.Collapse(accordionCollapseEl, { toggle: false }))
                },
                calcularPrecio() {
                    this.importe.monto = 0;
                    this.listaDetalle.forEach(d => {
                        if (d.tipo == "CHAPA") {
                            /*
                                largo y ancho estan en mm y pesoXm2 esta en m
                                ¿deberia pasar los mm a m?
                            */
                            const area = (d.largo / 1000) * (d.ancho / 1000); // los pase m, pero despues veo bien
                            const chapa = this.getChapas.find(c => c.id == d.chapa);
                            const peso = area * chapa.pesoXm2;
                            const precio = peso * chapa.precioXkg;

                            this.importe.monto += Math.ceil(precio);
                        }
                    });
                    this.importe.iva = this.importe.monto * 0.21;
                    this.importe.total = this.importe.monto + this.importe.iva;
                    // this.importe.total = this.importe.monto * 1.21;
                }@* ,
                calcularCantidadChapas() {
                    this.cantidadesChapas = { ...cantidadesChapasDefault };
                    this.listaDetalle.forEach(d => {
                        if (d.tipo == "CHAPA") {
                            const areaDeseada = (d.largo/1000 * d.ancho/1000) * d.cantidad;
                            // const chapa = chapas[mapaChapas.get(d.chapa)][d.espesor];
                            const chapa = this.getChapas.find(c => c.id == d.chapa);
                            const areaChapa = chapa.largo * chapa.ancho;
                            this.cantidadesChapas[mapaChapas.get(d.chapa)] += Math.ceil(areaDeseada / areaChapa);
                        }
                    });
                },
                getTipoChapa(clave) {
                    return mapaChapas.entries().find(entry => entry[1] == clave)[0];
                } *@
            },
            computed: {
                getTextoBotonAdd() {
                    return this.estaEditandoDetalle ? "Confirmar Edición" : "Agregar"
                },
                getTextoBotonLimpiar() {
                    return this.estaEditandoDetalle ? "Cancelar Edición" : "Limpiar Campos";
                },
                formatearImporte() {
                    return this.formateador.format(this.importe.monto);
                },
                formatearIVA() {
                    return this.formateador.format(this.importe.iva);
                },
                formatearImporteTotal() {
                    return this.formateador.format(this.importe.total);
                },
                getChapas() {
                    return this.materiales.filter(m => m.tipo == "CHAPA");//.map(c => { c.descripcion = c.descripcion.replace("Chapa ", ""); return c; });
                },
                getCanios() {
                    return this.materiales.filter(m => m.tipo == "CAÑO");//.map(c => { c.descripcion = c.descripcion.replace("Caño Estructural ", ""); return c; });
                },
                getPinturas() {
                    return this.materiales.filter(m => m.tipo == "PINTURA");
                }
            },
            mounted() {
                this.inicializarTooltips();
                this.calcularPrecio();
                @* this.calcularCantidadChapas(); *@
                this.inicializarAccordion();
            }
        }).mount("#app");
        function validarFormSelect(valor) {
            const valorNum = +valor;
            if (valor == 0)
                return "Requerido";
            return;
        }
        function validarInputNumber(valor) {
            if (typeof valor == "string")
                return "Requerido";
            if (valor <= 0)
                return "Debe ser mayor a 0";
        }
    </script>
}