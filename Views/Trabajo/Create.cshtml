<div id="app" class="container" v-cloak>
    <div class="row border rounded-4 p-3 mt-2">
        <div class="col-12 col-md-6 col-lg mt-2 mt-lg-0 position-relative">
            <label for="" class="form-label fw-bold">Cliente</label>
            <!-- Input Group con ícono y campo de búsqueda -->
            <div class="input-group mb-3">
                <!-- Ícono de Lupa (Bootstrap Icons) -->
                <span class="input-group-text bg-transparent border-end-0">
                    <i class="bi bi-search text-muted"></i>
                </span>
                
                <!-- Campo de entrada -->
                <input 
                    type="search" 
                    id="searchInput" 
                    class="form-control border-start-0 ps-0" 
                    placeholder="Buscar..." 
                    aria-label="Buscar"
                    v-model="search"
                    @@input="searchInputListener"
                    @@focus="mostrarItemsClientes(true)"
                    @@focusOut="mostrarItemsClientes(false)"
                >

                <!-- Botón opcional para limpiar la búsqueda -->
                <button 
                    type="button" id="clearBtn" 
                    class="btn btn-outline-secondary d-none" 
                    :class="{ 'd-none': search.trim().length > 0 }"
                    @@click="limpiarSearch"
                    style="cursor: pointer;"
                >
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <!-- Contenedor o lista donde se muestran/filtran los resultados -->
            <div id="resultsList" class="list-group position-absolute z-3 overflow-y-auto w-100" v-show="itemsClientes.length > 0 && searchFocused" style="height: 8em;">
                <button 
                    type="button" 
                    class="list-group-item list-group-item-action search-item" 
                    :class="{ active: index == 0, selected: index == 0 }"
                    :autofocus="index == 0"
                    v-for="(c, index) in itemsClientes" :key="c.id"
                    @@click="seleccionarCliente(c)"
                >
                    {{ c.apellido + ", " + c.nombre }}
                </button>
            </div>
        </div>
        <div class="col-12 col-md-6 col-lg mt-3 mt-lg-0">
            <label for="" class="form-label fw-bold">Fecha Solicitado</label>
            <input type="date" class="form-control" v-model="trabajo.fechaSolicitado">
        </div>
    </div>
    <div class="row border rounded-4 p-3 mt-2">
        <div class="col-12 d-flex justify-content-between align-items-start">
            <h3 class="display-4">Detalle</h3>
            <button type="button" class="btn btn-danger mt-2 mt-md-0" @@click="borrarDetalle">Borrar Detalle</button>
        </div>
        <div class="col mt-1">
            <div class="row">
                <div class="col-12 col-md-6 col-lg">
                    <label for="tipoOperacion" class="form-label fw-bold">Tipo Operación</label>
                    <select id="tipoOperacion" class="form-select" :class="{ 'is-invalid': erroresDetalleChapa.tipoOperacion }" v-model="itemDetalle.tipoOperacion">
                        <option value="" selected disabled>Seleccionar...</option>
                        <option value="Corte">Corte</option>
                        <option value="Plegado">Plegado</option>
                        <option value="Corte y Plegado">Corte y Plegado</option>
                        <option value="Corte Plasma">Corte Plasma</option>
                        <option value="Cilindrado">Cilindrado</option>
                    </select>
                    <div id="error_tipoOperacion" class="invalid-feedback" v-if="erroresDetalleChapa.tipoOperacion">{{ erroresDetalleChapa.tipoOperacion }}</div>
                </div>
                <div class="col-12 col-md-6 col-lg mt-3 mt-md-0">
                    <label for="chapa" class="form-label fw-bold">Chapa</label>
                    <select id="chapa" class="form-select" :class="{ 'is-invalid': erroresDetalleChapa.chapa }" v-model="itemDetalle.chapa" @@change="resetSelectEspesor">
                        <option value="" selected disabled>Seleccionar...</option>
                        <option value="Acero al Carbono">Acero al Carbono</option>
                        <option value="Galvanizada">Galvanizada</option>
                        <option value="Prepintada">Prepintada</option>
                    </select>
                    <div id="error_chapa" class="invalid-feedback" v-if="erroresDetalleChapa.chapa">{{ erroresDetalleChapa.chapa }}</div>
                </div>
                <div class="col-12 col-md-6 col-lg mt-3 mt-lg-0">
                    <label for="espesor" class="form-label fw-bold">Espesor</label>
                    <select id="espesor" class="form-select" :class="{ 'is-invalid': erroresDetalleChapa.espesor }" v-model="itemDetalle.espesor">
                        <option value="" selected disabled>Seleccionar...</option>
                        <option value="1/2" v-if="itemDetalle.chapa=='Acero al Carbono'">1/2</option>
                        <option value="3/8" v-if="itemDetalle.chapa=='Acero al Carbono'">3/8</option>
                        <option value="5/16" v-if="itemDetalle.chapa=='Acero al Carbono'">5/16</option>
                        <option value="1/4" v-if="itemDetalle.chapa=='Acero al Carbono'">1/4</option>
                        <option value="3/16" v-if="itemDetalle.chapa=='Acero al Carbono'">3/16</option>
                        <option value="1/8" v-if="itemDetalle.chapa=='Acero al Carbono'">1/8</option>
                        <option value="12" v-if="itemDetalle.chapa=='Acero al Carbono'">12</option>
                        <option value="14" v-if="itemDetalle.chapa=='Acero al Carbono'||itemDetalle.chapa=='Galvanizada'">14</option>
                        <option value="16" v-if="itemDetalle.chapa=='Acero al Carbono'||itemDetalle.chapa=='Galvanizada'">16</option>
                        <option value="18" v-if="itemDetalle.chapa=='Acero al Carbono'||itemDetalle.chapa=='Galvanizada'">18</option>
                        <option value="20" v-if="itemDetalle.chapa=='Acero al Carbono'||itemDetalle.chapa=='Galvanizada'">20</option>
                        <option value="22" v-if="itemDetalle.chapa=='Acero al Carbono'||itemDetalle.chapa=='Galvanizada'">22</option>
                        <option value="24">24</option>
                        <option value="27" v-if="itemDetalle.chapa=='Galvanizada'">27</option>
                        <option value="30" v-if="itemDetalle.chapa=='Galvanizada'">30</option>
                    </select>
                    <div id="error_espesor" class="invalid-feedback" v-if="erroresDetalleChapa.espesor">{{ erroresDetalleChapa.espesor }}</div>
                </div>
                <div class="col-12 col-md-6 col-lg mt-3 mt-lg-0">
                    <label for="largo" class="form-label fw-bold">Largo (mm)</label>
                    <input type="number" id="largo" class="form-control" :class="{ 'is-invalid': erroresDetalleChapa.largo }" v-model="itemDetalle.largo">
                    <div id="error_largo" class="invalid-feedback" v-if="erroresDetalleChapa.largo">{{ erroresDetalleChapa.largo }}</div>
                </div>
                <div class="col-12 col-md-6 col-lg mt-3 mt-lg-0">
                    <label for="ancho" class="form-label fw-bold">Ancho (mm)</label>
                    <input type="number" id="ancho" class="form-control" :class="{ 'is-invalid': erroresDetalleChapa.ancho }" v-model="itemDetalle.ancho">
                    <div id="error_ancho" class="invalid-feedback" v-if="erroresDetalleChapa.ancho">{{ erroresDetalleChapa.ancho }}</div>
                </div>
                <div class="col-12 col-md-6 col-lg mt-3 mt-lg-0">
                    <label for="cantidad" class="form-label fw-bold">Cantidad</label>
                    <input type="number" id="cantidad" class="form-control" :class="{ 'is-invalid': erroresDetalleChapa.cantidad }" v-model="itemDetalle.cantidad">
                    <div id="error_cantidad" class="invalid-feedback" v-if="erroresDetalleChapa.cantidad">{{ erroresDetalleChapa.cantidad }}</div>
                </div>
                <div class="col-12 mt-4 d-flex justify-content-evenly">
                    <button type="button" class="btn btn-secondary" @@click="limpiarInputsChapas">{{ getTextoBotonLimpiar }}</button>
                    <button type="button" class="btn btn-primary" @@click="addItemChapas">{{ getTextoBotonAdd }}</button>
                </div>
            </div>
            <div class="row mt-4">
                <div class="col">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between align-items-center" v-for="(i, index) in listaDetalle" :key="i.id">
                            <span>
                                {{ mostrarItemDetalle(i) }}
                                <span>
                                    <i 
                                        class="bi bi-pencil-square text-primary icon-hover fs-5 ms-2 ms-md-3" 
                                        data-bs-toggle="tooltip" 
                                        data-bs-title="Editar" 
                                        :data-item="index"
                                        @@click="editarDetalle(i)"
                                    ></i>
                                    <i 
                                        class="bi bi-trash text-danger icon-hover fs-5 ms-2 ms-md-3" 
                                        data-bs-toggle="tooltip" 
                                        data-bs-title="Eliminar" 
                                        :data-item="index"
                                        @@click="eliminarDetalle(i, index)"
                                    ></i>
                                </span>
                            </span>
                            <span class="badge text-bg-primary rounded-pill">{{ i.cantidad }}</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="col-12 border-top pt-2">
            <span class="fs-4">Cantidad de chapas estimada</span>
            <div>
                <ul class="list-group list-group-flush">
                    <li class="list-group-item fs-5" v-for="(value, key) in cantidadesChapas">
                        {{ getTipoChapa(key) }}: {{ value }}
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <div class="row border rounded-4 p-3 mt-2">
        <div class="col-12 d-flex flex-row-reverse p-1">
            <span class="fs-4">Importe: $ {{ formatearImporte }}</span>
        </div>
        <div class="col-12 d-flex flex-row-reverse p-1">
            <span class="fs-4">IVA: $ {{ formatearIVA }}</span>
        </div>
        <div class="col-12 d-flex flex-row-reverse p-1">
            <span class="fs-4">Importe Total: $ {{ formatearImporteTotal }}</span>
        </div>
    </div>

    
</div>

@section Scripts {
    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
    <script>
        const { createApp } = Vue;
        const itemDetalleDefault = { id: 0, tipo: "", tipoOperacion: "", chapa: "", espesor: "", largo: 0, ancho: 0, cantidad: 0 };
        @* const itemDetalleDefault = { id: 4, tipo: "chapa", tipoOperacion: "Corte", chapa: "Acero al Carbono", espesor: "14", largo: 1200, ancho: 560, cantidad: 3 }; *@
        const erroresDetalleChapaDefault = { tipoOperacion: null, chapa: null, espesor: null, largo: null, ancho: null, cantidad: null };
        const trabajoDefault = { id: 0, fechaSolicitado: null, clienteId: 0, detalle: [] };
        const importeDefault = { monto: 0, iva: 0, total: 0 };
        const cantidadesChapasDefault = { galvanizada: 0, Acarbono: 0, prepintada: 0 };
        const chapas = {
            galvanizada: {
                '14': {
                    largo: 2.44,
