<partial name="_ModalMensaje" model="new ModalMensaje() { Mensaje = ViewBag.MensajeError, Tipo = TipoMensaje.ERROR }"/>

@section Scripts {
    <script type="module">
        import { createApp } from 'https://unpkg.com/vue@3/dist/vue.esm-browser.js';
        import { getElementById, getFormInputValue, mostrarMensaje, mostrarPregunta } from "/js/frontUtils.js";
        import { 
            setInvalidInputStyle, 
            setValidInputStyle,
            resetValidationInputStyle ,
            setValidationErrorMessage,
            resetValidationErrorMessage
        } from "/js/validaciones.js";

        document.addEventListener("DOMContentLoaded", _ => {
            createApp({
                /* todo lo que retorna data son las variables que manejara la app y son el estado de esta y se referencian con 'this.' */
                data() {
                    // inicializo vacio erreglo de los clientes y genero la tabla inicial con Razor
                    // o inicializo el arrgeglo de los clientes con los valores del Model de la vista y luego se renderizan en el navegador con vue
                    // por ahora uso la segunda opcion
                    return {
                        clientes: @Html.Raw(JsonSerializer.Serialize(Model, serializationOptions)),
                        urlBase: "api/clientes",
                        limit: @limit,
                        paginaActual: @pagina,
                        busqueda: "@busqueda",
                        cantidadPaginas: @cantidadPaginas,
                        paginaSiguiente: @paginaSiguiente,
                        paginaAnterior: @paginaAnterior,
                        esPrimeraPagina: @(paginaAnterior == 0 ? "true" : "false"),
                        esUltimaPagina: @(paginaSiguiente > cantidadPaginas ? "true" : "false"),
                        estaCargando: false,
                        hayClientes: @(Model.Count() > 0 ? "true" : "false")
                    }
                },
                methods: {
                    async pedirClientes(page) {
                        if (page <= 0 || page > this.cantidadPaginas)
                            return;

                        let url = `${this.urlBase}?Limit=${this.limit}&Pagina=${page}`;
                        if (this.busqueda.length > 0)
                            url += `&Busqueda=${this.busqueda}`;
                        this.estaCargando = true;
                        const data = await this.hacerPeticion(url);
                        this.estaCargando = false;
                        if (data) {
                            this.actualizarDOM(data, page);
                        }
                    },
                    async onSubmit() {
                        if (this.busqueda === undefined || this.busqueda === null) 
                            return;
                        if (this.busqueda.trim() == "") 
                            return;
                        if (this.busqueda.length > 5) {
                            setInvalidInputStyle("buscador"); 
                            setValidationErrorMessage("tpe_buscador", "Valor de búsqueda muy largo");
                            return;
                        }

                        resetValidationInputStyle("buscador");
                        resetValidationErrorMessage("tpe_buscador");

                        let url = `${this.urlBase}?Limit=${this.limit}&Pagina=1&Busqueda=${this.busqueda}`;
                        this.estaCargando = true;
                        const data = await this.hacerPeticion(url);
                        this.estaCargando = false;
                        if (data) {
                            this.actualizarDOM(data, 1);
                        }
                    },
                    async hacerPeticion(url) {
                        try{
                            const response = await fetch(url);
                            if (response.ok) {
                                return await response.json();
                            } else {
                                const { mensaje } = await response.json();
                                mostrarMensaje(false, mensaje);
                            }
                        }
                        catch {
                            mostrarMensaje(false, "Se produjo un error al hacer la petición");
                        }
                    },
                    actualizarDOM(data, page) {
                        borrarFilasRazor();
                        this.clientes = data.clientes;
                        this.hayClientes = this.clientes.length > 0;
                        this.cantidadPaginas = data.cantidadPaginas;
                        this.paginaActual = page;
                        this.paginaAnterior = page - 1;
                        this.paginaSiguiente = page + 1;
                        this.esPrimeraPagina = this.paginaAnterior == 0;
                        this.esUltimaPagina = this.paginaSiguiente > this.cantidadPaginas;
                    },
                    limpiar() {
                        this.busqueda = "";
                        resetValidationInputStyle("buscador");
                        resetValidationErrorMessage("tpe_buscador");
                    }
                }
            }).mount('#app-clientes');

            inicializarTooltips();
        });

        function inicializarTooltips() {
            const tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]');
            const tooltipList = [...tooltipTriggerList].map(tooltipTriggerEl => new bootstrap.Tooltip(tooltipTriggerEl));
        }

        function borrarFilasRazor() {
            [...document.getElementsByClassName("borrar-filas")].forEach(el => { el.remove(); });
            [...document.getElementsByClassName("borrar-paginas")].forEach(el => { el.remove(); });
        }
    </script>
}