@using System.Text.Json
@using metalurgicaMVC.ViewModels
@model IEnumerable<ClienteVM>
@{
    ViewData["Title"] = "Clientes";
    int cantidadPaginas = ViewBag.cantPag;
    int pagina = ViewBag.pagina;
    int paginaAnterior = pagina - 1;
    int paginaSiguiente = pagina + 1;
    int limit = ViewBag.cantidadPaginado;
    string busqueda = ViewBag.busqueda ?? string.Empty;
    string mensajeEliminar = "el Cliente";
    var serializationOptions = new JsonSerializerOptions {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase
    };
    bool hayMensajeError = !string.IsNullOrWhiteSpace(ViewBag.MensajeError);
}

<div id="app-clientes" class="container-fluid bg-light-subtle position-relative" v-cloak>
    <h1 class="text-center display-4">Clientes</h1>

    <div class="row">
        <div class="col d-flex justify-content-end align-items-center mt-3 me-0 me-md-5">
            <button class="btn btn-outline-dark" @@click="recargar">
                <i class="bi bi-arrow-clockwise"></i>
                Recargar Todos
            </button>
        </div>
    </div>

    <form id="form_buscador" class="row needs-validation" @@submit.prevent="onSubmit">
       <div class="col-12 col-md-8 col-lg-6">
            <label for="buscador" class="form-label fw-bold">Buscar Cliente</label>
            <div class="input-group has-validation mb-3">
                <input 
                    type="text" 
                    id="buscador" 
                    v-model="busqueda" 
                    class="form-control" 
                    :class="{ 'is-invalid': errorBusqueda }" 
                    placeholder="nombre o apellido del cliente" 
                    value="@busqueda"
                >
                <span class="input-group-text" id="limpiar" style="cursor: pointer;" @@click="limpiarBusqueda">
                    <i class="bi bi-x-lg" data-bs-toggle="tooltip" data-bs-title="Limpiar Búsqueda"></i>
                </span>
                <div id="error_form_buscador" class="invalid-feedback" v-if="errorBusqueda">{{ errorBusqueda }}</div>
                <button type="submit" class="btn btn-primary" :disabled="estaCargando">
                    <i class="bi bi-search"></i>
                    Buscar
                </button>
            </div>
        </div>
    </form>
    
    <div class="row">
        <div class="col my-2">
            <div class="table-responsive my-2 fixed-height-table-container">
                <table class="table table-hover text-nowrap">
                    <thead class="table-light border border-start-0 border-top-0 border-end-0 border-2 border-black">
                        <tr>
                            <th>
                                @Html.DisplayNameFor(model => model.Apellido).ToUpper()
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.Nombre).ToUpper()
                            </th>
                            <th colspan="2">
                                @Html.DisplayNameFor(model => model.Direccion).ToUpper()
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.Telefono).ToUpper()
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.Cuit).ToUpper()
                            </th>
                            <th>ACCIONES</th>
                        </tr>
                    </thead>
                    <tbody id="cuerpo">
                        <tr :id="c.id" v-for="c in clientes" :key="c.id">
                            <td class="align-middle py-0 ps-2"> {{ c.apellido }} </td>
                            <td class="align-middle py-0 ps-2"> {{ c.nombre }} </td>
                            <td class="align-middle py-0 ps-2" colspan="2"> {{ c.direccion }} </td>
                            <td class="align-middle py-0 ps-2"> {{ c.telefono }} </td>
                            <td class="align-middle py-0 ps-2"> {{ c.cuit }} </td>
                            <td>
                                <div class="d-flex justify-content-evenly align-items-center">
                                    <i 
                                        :data-cliente-id="c.id" 
                                        class="bi bi-pencil-square fs-3 text-primary icon-hover" 
                                        @@click="abrirFormModal(c)" 
                                        data-bs-toggle="tooltip" data-bs-title="Editar"
                                    ></i>
                                    <i 
                                        :data-cliente-id="c.id" 
                                        class="bi bi-trash fs-3 text-danger icon-hover" 
                                        @@click="abrirModalEliminar(c.id)" 
                                        data-bs-toggle="tooltip" data-bs-title="Eliminar"
                                    ></i>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    
    <div class="row border-top position-relative">
        <nav id="nav" class="col pt-3">
            <ul id="paginador" class="pagination justify-content-center">
                <li id="flecha-pag-izq" class="page-item" :class="{ disabled: esPrimeraPagina }" data-bs-toggle="tooltip" data-bs-title="Anterior">
                    <span @@click="pedirClientes(paginaAnterior)" class="page-link"><span>&laquo;</span></span>
                </li>
                <li class="page-item" v-for="p in cantidadPaginas">
                    <a  @@click="pedirClientes(p)" class="page-link" :class="{ active: p == paginaActual, disabled: cantidadPaginas == 1 }">{{ p }}</a>
                </li>
                <li id="flecha-pag-der" class="page-item" :class="{ disabled: esUltimaPagina }" data-bs-toggle="tooltip" data-bs-title="Siguiente">
                    <span @@click="pedirClientes(paginaSiguiente)" class="page-link"><span>&raquo;</span></span>
                </li>
            </ul>
        </nav>
        <div id="btn_add" class="position-absolute top-0 end-0 me-1 mt-3 mt-sm-2 mt-lg-1">
            <i 
                class="bi bi-plus-square fs-1 text-primary icon-hover d-inline-block" 
                data-bs-toggle="tooltip" data-bs-title="Registrar Nuevo" 
                @@click="abrirFormModal"
            ></i>
        </div>
    </div>

    <partial name="_ModalEliminar" model="mensajeEliminar"/>
    <partial name="_FormModal" model="new ClienteVM()"/>
    <partial name="_ModalMensaje"/>
</div>


@section Scripts {
    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", _ => {
            const { createApp } = Vue;
            let modalEliminar;
            let formModal;
            let modalMonseaje;
            const clientePorDefecto = { id: 0, tipo: "", nombre: "", apellido: "", telefono: "", direccion: "", cuit: "" }
            const erroresClienteDefault = { tipo: null, nombre: null, apellido: null, telefono: null, direccion: null, cuit: null };
            createApp({
                data() {
                    return {
                        clientes: @Html.Raw(JsonSerializer.Serialize(Model, serializationOptions)),
                        urlBase: "api/clientes",
                        limit: @limit,
                        paginaActual: @pagina,
                        busqueda: "@busqueda",
                        errorBusqueda: null,
                        cantidadPaginas: @cantidadPaginas,
                        paginaSiguiente: @paginaSiguiente,
                        paginaAnterior: @paginaAnterior,
                        esPrimeraPagina: @(paginaAnterior == 0 ? "true" : "false"),
                        esUltimaPagina: @(paginaSiguiente > cantidadPaginas ? "true" : "false"),
                        estaCargando: false,
                        hayClientes: @(Model.Count() > 0 ? "true" : "false"),
                        clienteIdEliminar: 0,
                        cliente: { ...clientePorDefecto },
                        erroresCliente: { ...erroresClienteDefault },
                        estaEditando: false,
                        mensaje: "",
                        esMensajeError: false,
                        tooltipTriggerList: [],
                        tooltipList: []
                    }
                },
                methods: {
                    async pedirClientes(page) {
                        if (page <= 0 || page > this.cantidadPaginas)
                            return;
                        let url = `${this.urlBase}?Limit=${this.limit}&Pagina=${page}`;
                        if (this.busqueda.length > 0)
                            url += `&Busqueda=${this.busqueda}`;
                        this.estaCargando = true;
                        const data = await this.hacerPeticion(url);
                        this.estaCargando = false;
                        if (data) {
                            this.actualizarDOM(data, page);
                        }
                    },
                    async onSubmit() {
                        if (this.busqueda === undefined || this.busqueda === null) 
                            return;
                        if (this.busqueda.trim() == "") 
                            return;
                        if (this.busqueda.length > 25) {
                            this.errorBusqueda = "Valor de búsqueda muy largo";
                            return;
                        }
                        this.errorBusqueda = null;
                        let url = `${this.urlBase}?Limit=${this.limit}&Pagina=1&Busqueda=${this.busqueda}`;
                        this.estaCargando = true;
                        const data = await this.hacerPeticion(url);
                        this.estaCargando = false;
                        if (data) {
                            this.actualizarDOM(data, 1);
                        }
                    },
                    async hacerPeticion(url) {
                        try{
                            const response = await fetch(url);
                            if (response.ok) {
                                return await response.json();
                            } else {
                                const { mensaje, errors } = await response.json();
                                if (mensaje) {
                                    this.mostrarMensaje(mensaje, false);
                                }
                                if (errors) {
                                    mensaje = "";
                                    Object.keys(errors).forEach((e, i) => {
                                        mensaje += `${e}: ${errors[e].join(", ")}`;
                                        if (i < errors.length-1)
                                            mensaje += " - ";
                                    });
                                }
                                return null;
                            }
                        }
                        catch {
                            this.mostrarMensaje("Error al traer los clientes", false);
                        }
                    },
                    actualizarDOM(data, page) {
                        this.clientes = data.clientes;
                        this.hayClientes = this.clientes.length > 0;
                        this.cantidadPaginas = data.cantidadPaginas;
                        this.paginaActual = page;
                        this.paginaAnterior = page - 1;
                        this.paginaSiguiente = page + 1;
                        this.esPrimeraPagina = this.paginaAnterior == 0;
                        this.esUltimaPagina = this.paginaSiguiente > this.cantidadPaginas;
                        setTimeout(() => { this.inicializarTooltips(); }, 2000);
                    },
                    limpiarBusqueda() {
                        this.busqueda = "";
                        this.errorBusqueda = null;
                    },
                    recargar() {
                        this.limpiarBusqueda();
                        this.pedirClientes(1);
                    },
                    abrirModalEliminar(id) {
                        this.clienteIdEliminar = id;
                        if (modalEliminar  == undefined)
                            modalEliminar = new bootstrap.Modal(document.getElementById('modal-eliminar'), {});
                        modalEliminar.show();
                    },
                    async eliminar() {
                        if (this.clienteIdEliminar > 0) {
                            this.estaCargando = true;
                            try {
                                const response = await fetch(`${this.urlBase}/${this.clienteIdEliminar}`, { method: "DELETE" });
                                if (response.ok) {
                                    let url = `${this.urlBase}?Limit=${this.limit}&Pagina=${this.paginaActual}`;
                                    if (this.busqueda.length > 0)
                                        url += `&Busqueda=${this.busqueda}`;
                                    const data = await this.hacerPeticion(url);
                                    if (data) {
                                        this.actualizarDOM(data, this.paginaActual);
                                    }
                                    this.mostrarMensaje("Cliente eliminado");
                                } else {
                                    const { mensaje } = await response.json();
                                    this.mostrarMensaje(mensaje, false);
                                }
                            }
                            catch {
                                this.mostrarMensaje("Error al eliminar el cliente", false);
                            }
                            this.estaCargando = false;

                            if (modalEliminar != undefined)
                                modalEliminar.hide();
                        }
                    },
                    abrirFormModal(cliente) {
                        if (cliente instanceof Event) {
                            this.cliente = { ...clientePorDefecto };
                        }
                        else {
                            this.cliente = { ...cliente };
                            this.estaEditando = true;
                        }
                        this.erroresCliente = { ...erroresClienteDefault };
                        if (formModal == undefined)
                            formModal = new bootstrap.Modal(document.getElementById('modal_formulario_cliente'), {});
                        formModal.show();
                    },
                    cancelarEditar() {
                        this.estaEditando = false;
                    },
                    async onSubmitCliente() {
                        this.estaCargando = true;
                        if (this.esFormularioValido()) {
                            let url = this.urlBase;
                            const opcionesFetch = { 
                                method: "POST",
                                headers: { 
                                    'Content-Type': 'application/json',
                                    'RequestVerificationToken': document.getElementsByName("__RequestVerificationToken")?.item(0)?.value
                                },
                                body: JSON.stringify(this.cliente)
                            };
                            if (this.estaEditando) {
                                url += `/${this.cliente.id}`;
                                opcionesFetch.method = "PUT";
                            }
                            try{
                                const response = await fetch(url, opcionesFetch);
                                if (response.ok) {
                                    const data = await response.json();
                                    if (this.estaEditando) {
                                        const indiceClienteActualizado = this.clientes.findIndex(c => c.id == data?.cliente.id);
                                        if (indiceClienteActualizado >= 0) {
                                            this.clientes[indiceClienteActualizado] = data?.cliente;
                                        }
                                    } else {
                                        @* if (this.clientes.length < this.limit) 
                                            this.clientes.push(data?.usuario);
                                        else if (this.esUltimaPagina) {
                                            this.cantidadPaginas++;
                                            this.esUltimaPagina = false;
                                        } *@
                                        url = `${this.urlBase}?Limit=${this.limit}&Pagina=${this.paginaActual}`;
                                        if (this.busqueda.length > 0)
                                            url += `&Busqueda=${this.busqueda}`;
                                        const data = await this.hacerPeticion(url);
                                        if (data) {
                                            this.actualizarDOM(data, this.paginaActual);
                                        }
                                    }
                                    if (formModal != undefined)
                                        formModal.hide();
                                    this.mostrarMensaje(`Cliente ${this.estaEditando ? "Actualizado" : "Registrado" }`);
                                } else {
                                    const { mensaje, errors } = await response.json();
                                    if (errors) {
                                        Object.keys(errors).forEach(e => {
                                            this.erroresCliente[e.toLowerCase()] = errors[e].join(", ");
                                        });
                                    } else {
                                        this.mostrarMensaje(mensaje ?? "La petición no es correcta", false);
                                    }
                                }
                            } catch {
                                this.mostrarMensaje(`Se produjo un error al ${this.estaEditando ? "Actualizar" : "Registrar" }`, false);
                            }
                        }
                        this.estaEditando = false;
                        this.estaCargando = false;
                    },
                    esFormularioValido() {
                        const mapaValidador = new Map([
                            ["tipo", this.validarSelectTipo],
                            ["nombre", this.validarNombre],
                            ["apellido", this.validarApellido],
                            ["cuit", this.validarCUIT],
                            ["telefono", this.validarTelefono],
                            ["direccion", this.validarDireccion]
                        ]);
                        const clavesAValidar = [...mapaValidador.keys()];
                        Object.keys(this.cliente)
                            .forEach(key => {
                                if (!clavesAValidar.includes(key)) return;
                                this.erroresCliente[key] = mapaValidador.get(key)(this.cliente[key]);
                            }
                        );
                        return !Object.keys(this.erroresCliente).some(v => this.erroresCliente[v]);
                    },
                    limpiarFormulario() {
                        this.cliente = { ...clientePorDefecto };
                        this.erroresCliente = { ...erroresClienteDefault };
                    },
                    mostrarMensaje(mensaje, ok = true) {
                        this.mensaje = mensaje;
                        this.esMensajeError = !ok;
                        if (!modalMonseaje)
                            modalMonseaje = new bootstrap.Modal(document.getElementById('modal-mensaje'), {});
                        modalMonseaje.show();
                    },
                    inicializarTooltips() {
                        this.tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]');
                        this.tooltipList = [...this.tooltipTriggerList].map(tooltipTriggerEl => new bootstrap.Tooltip(tooltipTriggerEl));
                    },
                    onChangeTipoCliente() {
                        this.erroresCliente.tipo = null;
                        this.erroresCliente.nombre = null;
                        this.erroresCliente.apellido = null;
                        if (this.cliente.tipo == "EMPRESA") {
                            this.cliente.apellido = "";
                        }
                    },
                    validarCUIT() {
                        const cuit = this.cliente.cuit;
                        if (!cuit || cuit.trim().length == 0) 
                            return;
                        if (cuit.length > 13) 
                            return "El CUIT es muy largo";
                        const regExp = /^\d{2}\-\d{7,8}\-\d{1}$/;
                        if (!regExp.test(cuit)) 
                            return "El formato inválido";
                        return;
                    },
                    validarNombre() {
                        const nombre = this.cliente.nombre;
                        const tipo = this.cliente.tipo;
                        if (tipo == "PERSONA") { // tiene que estar nombre o apellido o ambos
                            if (nombre.trim() == "" && this.cliente.apellido.trim() == "") 
                                return "El nombre y apellido no pueden estar ambos vacíos";
                        } else if (tipo == "EMPRESA") { // tiene que estar el nombre y el apellido no
                            if (nombre.trim() == "") return "El nombre de la empresa es requerido";
                        } else {
                            return "Falta seleccionar el tipo de cliente";
                        }
                        if (nombre.length > 30) return "El máximo de caracteres de de 30";
                        return;
                    },
                    validarApellido() {
                        const tipo = this.cliente.tipo;
                        if (tipo == "PERSONA") { // tiene que estar nombre o apellido o ambos
                            const apellido = this.cliente.apellido;
                            if (this.cliente.nombre.trim() == "" && apellido.trim() == "") 
                                return "El nombre y apellido no pueden estar ambos vacíos";
                            if (apellido.length > 30) 
                                return "El máximo de caracteres de de 30";
                        } else if (tipo == "") {
                            return "Falta seleccionar el tipo de cliente";
                        }
                        return;
                    },
                    validarTelefono() {
                        const telefono = this.cliente.telefono;
                        if (!telefono) return;
                        if (telefono.trim().length == 0) return;
                        if (telefono.length > 20) return "El máximo de caracteres de de 20.";
                        // const regExp = /^(\+54\s)?0?(\d{2,4})\s(15\s)?(\d{4}-?\d{4})|(\d{3}-?\d{4})|(\d{2}-?\d{4})$/;
                        const regExp = /^\+?[0-9\s\-]{6,20}$/;
                        if (!regExp.test(telefono)) return "El teléfono tiene caractares inválidos";
                        return;
                    },
                    validarDireccion() {
                        const dir = this.cliente.direccion;
                        if (!dir || dir.trim().length === 0) 
                            return;
                        if (dir.length > 100) {
                            return "La dirección no puede superar los 100 caracteres";
                        }
                        return;
                    },
                    validarSelectTipo(valor) {
                        const tipo = this.cliente.tipo;
                        if (!tipo || tipo.trim().length == 0)
                            return "Falta el valor";
                        return;
                    }
                },
                mounted() {
                    if (@(hayMensajeError.ToString().ToLower())) {
                        this.mostrarMensaje("@ViewBag.MensajeError", false);
                    }
                    this.inicializarTooltips();
                }
            }).mount('#app-clientes');
        });
    </script>
}