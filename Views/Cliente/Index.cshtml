@using System.Text.Json
@using metalurgicaMVC.ViewModels
@model IEnumerable<ClienteVM>
@{
    ViewData["Title"] = "Clientes";
    int cantidadPaginas = ViewBag.cantPag;
    int pagina = ViewBag.pagina;
    int paginaAnterior = pagina - 1;
    int paginaSiguiente = pagina + 1;
    int limit = ViewBag.cantidadPaginado;
    string busqueda = ViewBag.busqueda ?? string.Empty;
    string mensajeEliminar = "el Cliente";
    var serializationOptions = new JsonSerializerOptions {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase
    };
}

<div id="app-clientes" class="container-fluid shadow border rounded-4 bg-light-subtle position-relative">
    <h1 class="text-center display-4">Clientes</h1>

    <div class="row">
       <div class="col-6">
            <form id="form_buscador" class="position-relative needs-validation" @@submit.prevent="onSubmit">
                <label for="buscador" class="form-label fw-bold">Buscar Cliente</label>
                <div class="input-group has-validation mb-3">
                    <input type="text" id="buscador" v-model="busqueda" class="form-control" placeholder="nombre o apellido del cliente" value="@busqueda">
                    <span class="input-group-text" id="limpiar" style="cursor: pointer;" @@click="limpiar">
                        <i class="bi bi-x-lg" data-bs-toggle="tooltip" data-bs-title="Limpiar"></i>
                    </span>
                    <div id="tpe_form_buscador" class="invalid-tooltip"></div>
                    <button type="submit" class="btn btn-primary" :disabled="estaCargando">
                        <i class="bi bi-search"></i>
                        Buscar
                    </button>
                </div>
                <input type="hidden" name="limit" value="@limit">
            </form>
        </div>
        <div class="col d-flex justify-content-end align-items-center mt-3 me-5">
            <button class="btn btn-outline-dark" @@click="pedirClientes(1)">
                <i class="bi bi-arrow-clockwise"></i>
                Recargar Todos
            </button>
        </div>
    </div>
    <div class="table-responsive my-2 rounded-3 fixed-height-table-container">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.Id).ToUpper()
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Apellido).ToUpper()
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Nombre).ToUpper()
                    </th>
                    <th colspan="2">
                        @Html.DisplayNameFor(model => model.Direccion).ToUpper()
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Telefono).ToUpper()
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Cuit).ToUpper()
                    </th>
                    <th></th>
                </tr>
            </thead>
            <tbody id="cuerpo">
                <tr :id="c.id" v-for="c in clientes" :key="c.id" v-cloak>
                    <td class="align-middle py-0 ps-2"> {{ c.id }} </td>
                    <td class="align-middle py-0 ps-2"> {{ c.apellido }} </td>
                    <td class="align-middle py-0 ps-2"> {{ c.nombre }} </td>
                    <td class="align-middle py-0 ps-2" colspan="2"> {{ c.direccion }} </td>
                    <td class="align-middle py-0 ps-2"> {{ c.telefono }} </td>
                    <td class="align-middle py-0 ps-2"> {{ c.cuit }} </td>
                    <td>
                        <div class="d-flex justify-content-evenly align-items-center">
                            <i :data-cliente-id="c.id" class="bi bi-pencil-square fs-3 text-primary icon-hover" style="cursor: pointer;" data-bs-toggle="tooltip" data-bs-title="Editar"></i>
                            <i :data-cliente-id="c.id" class="bi bi-trash fs-3 text-danger icon-hover" style="cursor: pointer;" data-bs-toggle="tooltip" data-bs-title="Eliminar"></i>
                        </div>
                    </td>
                </tr>
                @* @foreach (var item in Model)
                {
                    <tr id="@item.Id" class="borrar-filas">
                        <td class="align-middle py-0 ps-2">
                            @Html.DisplayFor(modelItem => item.Id)
                        </td>
                        <td class="align-middle py-0 ps-2">
                            @Html.DisplayFor(modelItem => item.Apellido)
                        </td>
                        <td class="align-middle py-0 ps-2">
                            @Html.DisplayFor(modelItem => item.Nombre)
                        </td>
                        <td class="align-middle py-0 ps-2" colspan="2">
                            @Html.DisplayFor(modelItem => item.Direccion)
                        </td>
                        <td class="align-middle py-0 ps-2">
                            @Html.DisplayFor(modelItem => item.Telefono)
                        </td>
                        <td class="align-middle py-0 ps-2">
                            @Html.DisplayFor(modelItem => item.Cuit)
                        </td>
                        <td>
                            <div class="d-flex justify-content-evenly align-items-center">
                                <i data-clienteId="@item.Id" class="bi bi-pencil-square fs-3 text-primary icon-hover" style="cursor: pointer;" data-bs-toggle="tooltip" data-bs-title="Editar"></i>
                                <i data-clienteId="@item.Id" class="bi bi-trash fs-3 text-danger icon-hover" style="cursor: pointer;" data-bs-toggle="tooltip" data-bs-title="Eliminar"></i>
                            </div>
                        </td>
                    </tr>
                } *@
            </tbody>
        </table>
    </div>
    <nav id="nav">
        <ul id="paginador" class="pagination justify-content-center" v-cloak>
            <li id="flecha-pag-izq" class="page-item" :class="{ disabled: esPrimeraPagina }" data-bs-toggle="tooltip" data-bs-title="Anterior" style="cursor: pointer;">
                <span @@click="pedirClientes(paginaAnterior)" class="page-link"><span>&laquo;</span></span>
            </li>
            <li class="page-item" v-for="p in cantidadPaginas" style="cursor: pointer;">
                <a  @@click="pedirClientes(p)" class="page-link" :class="{ active: p == paginaActual, disabled: cantidadPaginas == 1 }">{{ p }}</a>
            </li>
            <li id="flecha-pag-der" class="page-item" :class="{ disabled: esUltimaPagina }" data-bs-toggle="tooltip" data-bs-title="Siguiente" style="cursor: pointer;">
                <span @@click="pedirClientes(paginaSiguiente)" class="page-link"><span>&raquo;</span></span>
            </li>
        </ul>
    </nav>
    <div id="btn_add" class="position-absolute bottom-0 end-0 me-4 mb-2" style="cursor: pointer;">
        <i class="bi bi-plus-square fs-1 text-primary icon-hover d-inline-block" data-bs-toggle="tooltip" data-bs-title="Registrar Nuevo"></i>
    </div>
</div>

<partial name="_ModalEliminar" model="mensajeEliminar"/>
