@using metalurgicaMVC.ViewModels
@model ClienteVM

<div id="modal_formulario_cliente" class="modal fade modal-lg" tabindex="-1" aria-describedby="titulo-modal">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-light-subtle">
            <div class="modal-header">
                <div id="titulo-modal" class="modal-title fs-5">Formulario</div>
                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body justify-content-center align-items-center">
                <div class="container-md">
                    <div class="d-flex justify-content-center align-items-center vh-50 w-100">
                        <form 
                            id="form-cliente" 
                            @@submit.prevent="onSubmitCliente" 
                            class="p-3 w-100 mx-auto border rounded-4 shadow-sm needs-validation bg-light" 
                            asp-antiforgery="true"
                        >

                            <div class="row mb-md-4">
                                <div class="col-12 col-md-6 mt-5 mt-md-3 mb-md-0">
                                    <div class="position-relative">
                                        <label asp-for="Nombre" class="form-label fw-bold">@Html.DisplayNameFor(model => model.Nombre)</label>
                                        <input type="text" asp-for="Nombre" v-model="cliente.nombre" class="form-control" id="nombre">
                                        <div id="tpe_nombre" class="invalid-tooltip"></div>
                                    </div>
                                </div>
                                <div class="col-12 col-md-6 mt-5 mt-md-3 mb-md-0">
                                    <div class="position-relative">
                                        <label asp-for="Apellido" class="form-label fw-bold">@Html.DisplayNameFor(model => model.Apellido)</label>
                                        <input type="text" asp-for="Apellido" v-model="cliente.apellido" class="form-control" id="apellido">
                                        <div id="tpe_apellido" class="invalid-tooltip"></div>
                                    </div>
                                </div>
                            </div>

                            <div class="row mb-md-4">
                                <div class="col-12 col-md-6 mt-5 mt-md-3 mb-md-0">
                                    <div class="position-relative">
                                        <label asp-for="Direccion" class="form-label fw-bold">@Html.DisplayNameFor(model => model.Direccion)</label>
                                        <input type="text" asp-for="Direccion" v-model="cliente.direccion" class="form-control" id="direccion">
                                        <div id="tpe_direccion" class="invalid-tooltip"></div>
                                    </div>
                                </div>
                                <div class="col-12 col-md-6 mt-5 mt-md-3 mb-md-0">
                                    <div class="position-relative">
                                        <label asp-for="Telefono" class="form-label fw-bold">@Html.DisplayNameFor(model => model.Telefono)</label>
                                        <input type="text" asp-for="Telefono" v-model="cliente.telefono" class="form-control" id="telefono">
                                        <div id="tpe_telefono" class="invalid-tooltip"></div>
                                    </div>
                                </div>
                            </div>

                            <div class="row mb-md-5">
                                <div class="col-12 col-md-6 mt-5 mt-md-3 mb-md-0">
                                    <div class="position-relative">
                                        <label asp-for="Cuit" class="form-label fw-bold">@Html.DisplayNameFor(model => model.Cuit)</label>
                                        <input type="text" asp-for="Cuit" v-model="cliente.cuit" class="form-control" id="cuit">
                                        <div id="tpe_cuit" class="invalid-tooltip"></div>
                                    </div>
                                </div>
                            </div>

                            <input id="clienteId" type="hidden" asp-for="Id" v-model="cliente.id" aria-hidden="true"/>

                            <div class="row mb-2 mt-5 mt-md-4 justify-content-evenly align-items-end pt-3">
                                <div class="col-2 d-flex justify-content-center">
                                    <button type="submit" class="btn btn-primary d-block mx-auto" :class="{ disabled: estaCargando }" :disabled="estaCargando">Guardar</button>
                                </div>
                                <div class="col-2 d-flex justify-content-center">
                                    <button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">Cancelar</button>
                                </div>
                            </div>
                        </form>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>