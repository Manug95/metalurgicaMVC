@using System.Text.Json
@using metalurgicaMVC.ViewModels
@model IEnumerable<TipoOperacionVM>
@{
    ViewData["Title"] = "Tipos de Operación";
    int cantidadPaginas = ViewBag.cantPag;
    int pagina = ViewBag.pagina;
    int paginaAnterior = pagina - 1;
    int paginaSiguiente = pagina + 1;
    int limit = ViewBag.cantidadPaginado;
    string mensajeEliminar = "¿Eliminar el Tipo de operación?";
    var serializationOptions = new JsonSerializerOptions {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase
    };
    bool hayMensajeError = !string.IsNullOrWhiteSpace(ViewBag.MensajeError);
}

<div id="app-tipoOperacion" class="container-fluid bg-light-subtle" v-cloak>
    <h1 class="text-center display-4">Tipo de Operación</h1>

    <div class="row">
        <div class="col d-flex justify-content-end align-items-center mt-3 me-0 me-md-5">
            <button class="btn btn-outline-dark" @@click="recargar">
                <i class="bi bi-arrow-clockwise"></i>
                Recargar Todos
            </button>
        </div>
    </div>
    
    <div class="row">
        <div class="col my-2">
            <div class="table-responsive my-2 fixed-height-table-container">
                <table class="table table-hover text-nowrap">
                    <thead class="table-light border border-start-0 border-top-0 border-end-0 border-2 border-black">
                        <tr>
                            <th>
                                @Html.DisplayNameFor(model => model.Id).ToUpper()
                            </th>
                            <th colspan="2">
                                @Html.DisplayNameFor(model => model.Nombre).ToUpper()
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.CostoFijo).ToUpper()
                            </th>
                            <th>ACCIONES</th>
                        </tr>
                    </thead>
                    <tbody id="cuerpo">
                        <tr :id="to.id" v-for="to in tiposOperaciones" :key="to.id">
                            <td class="align-middle py-0 ps-2"> {{ to.id }} </td>
                            <td class="align-middle py-0 ps-2" colspan="2"> {{ to.nombre }} </td>
                            <td class="align-middle py-0 ps-2"> {{ formatearCostoFijo(to.costoFijo) }} </td>
                            <td>
                                <div class="d-flex justify-content-evenly align-items-center">
                                    <i 
                                        :data-material-id="to.id" 
                                        class="bi bi-pencil-square fs-3 text-primary icon-hover" 
                                        @@click="abrirFormModal(to)" 
                                        data-bs-toggle="tooltip" data-bs-title="Editar"
                                    ></i>
                                    <i 
                                        :data-material-id="to.id" 
                                        class="bi bi-trash fs-3 text-danger icon-hover" 
                                        @@click="abrirModalEliminar(to.id)" 
                                        data-bs-toggle="tooltip" data-bs-title="Eliminar"
                                    ></i>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    
    <div class="row border-top position-relative">
        <nav id="nav" class="col pt-3">
            <ul id="paginador" class="pagination justify-content-center">
                <li id="flecha-pag-izq" class="page-item" :class="{ disabled: esPrimeraPagina }" data-bs-toggle="tooltip" data-bs-title="Anterior">
                    <span @@click="pedirTiposOperaciones(paginaAnterior)" class="page-link"><span>&laquo;</span></span>
                </li>
                <li class="page-item" v-for="p in cantidadPaginas">
                    <a  @@click="pedirTiposOperaciones(p)" class="page-link" :class="{ active: p == paginaActual, disabled: cantidadPaginas == 1 }">{{ p }}</a>
                </li>
                <li id="flecha-pag-der" class="page-item" :class="{ disabled: esUltimaPagina }" data-bs-toggle="tooltip" data-bs-title="Siguiente">
                    <span @@click="pedirTiposOperaciones(paginaSiguiente)" class="page-link"><span>&raquo;</span></span>
                </li>
            </ul>
        </nav>
        <div id="btn_add" class="position-absolute top-0 end-0 me-1 mt-3 mt-sm-2 mt-lg-1">
            <i 
                class="bi bi-plus-square fs-1 text-primary icon-hover d-inline-block" 
                data-bs-toggle="tooltip" data-bs-title="Registrar Nuevo" 
                @@click="abrirFormModal"
            ></i>
        </div>
    </div>

    <partial name="_ModalEliminar" model="mensajeEliminar"/>
    <partial name="_FormModal" model="new TipoOperacionVM()"/>
    <partial name="_ModalMensaje"/>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", _ => {
            const { createApp } = Vue;
            let modalEliminar;
            let formModal;
            let modalMensaje;
            const tipoOperacionDefault = { id: 0, nombre: "", costoFijo: "" }
            const erroresTipoOperacionDefault = { nombre: null, costoFijo: null };
            createApp({
                data() {
                    return {
                        tiposOperaciones: @Html.Raw(JsonSerializer.Serialize(Model, serializationOptions)),
                        urlBase: "/api/TipoOperacion",
                        limit: @limit,
                        erroresTipoOperacion: { ...erroresTipoOperacionDefault },
                        paginaActual: @pagina,
                        cantidadPaginas: @cantidadPaginas,
                        paginaSiguiente: @paginaSiguiente,
                        paginaAnterior: @paginaAnterior,
                        esPrimeraPagina: @(paginaAnterior == 0 ? "true" : "false"),
                        esUltimaPagina: @(paginaSiguiente > cantidadPaginas ? "true" : "false"),
                        estaCargando: false,
                        estaEliminando: false,
                        estaGuardando: false,
                        estaEditando: false,
                        tipoOperacionIdEliminar: 0,
                        tipoOperacion: { ...tipoOperacionDefault },
                        mensaje: "",
                        esMensajeError: false,
                        tooltipTriggerList: [],
                        tooltipList: [],
                        formateador: new Intl.NumberFormat('es-ES', { minimumFractionDigits: 2, maximumFractionDigits: 2 }),
                    };
                },
                methods: {
                    async pedirTiposOperaciones(page) {
                        if (page <= 0 || page > this.cantidadPaginas)
                            return;
                        let url = `${this.urlBase}?Limit=${this.limit}&Pagina=${page}`;
                        this.estaCargando = true;
                        const data = await this.hacerPeticion(url);
                        this.estaCargando = false;
                        if (data) {
                            this.actualizarDOM(data, page);
                        }
                    },
                    async hacerPeticion(url) {
                        try{
                            const response = await fetch(url, { headers: { "Authorization": `Bearer ${sessionStorage.getItem("jwt")}` } });
                            if (response.ok) {
                                return await response.json();
                            } else {
                                const { mensaje, errors } = await response.json();
                                if (mensaje) {
                                    this.mostrarMensaje(mensaje, false);
                                }
                                if (errors) {
                                    mensaje = "";
                                    Object.keys(errors).forEach((e, i) => {
                                        mensaje += `${e}: ${errors[e].join(", ")}`;
                                        if (i < errors.length-1)
                                            mensaje += " - ";
                                    });
                                }
                                return null;
                            }
                        }
                        catch {
                            this.mostrarMensaje("Error al traer los tipos de operación", false);
                        }
                    },
                    actualizarDOM(data, page) {
                        this.tiposOperaciones = data.tiposOperaciones;
                        this.cantidadPaginas = data.cantidadPaginas;
                        this.paginaActual = page;
                        this.paginaAnterior = page - 1;
                        this.paginaSiguiente = page + 1;
                        this.esPrimeraPagina = this.paginaAnterior == 0;
                        this.esUltimaPagina = this.paginaSiguiente > this.cantidadPaginas;
                        setTimeout(() => { this.inicializarTooltips(); }, 2000);
                    },
                    recargar() {
                        this.pedirTiposOperaciones(1);
                    },
                    abrirModalEliminar(id) {
                        this.tipoOperacionIdEliminar = id;
                        if (!modalEliminar)
                            modalEliminar = new bootstrap.Modal(document.getElementById('modal-eliminar'), {});
                        modalEliminar.show();
                    },
                    async eliminar() {
                        if (this.tipoOperacionIdEliminar > 0 && !this.estaEliminando) {
                            if (modalEliminar)
                                modalEliminar.hide();
                            this.estaEliminando = true;
                            try {
                                const response = await fetch(`${this.urlBase}/${this.tipoOperacionIdEliminar}`, { 
                                    method: "DELETE",
                                    headers: { "Authorization": `Bearer ${sessionStorage.getItem("jwt")}` }
                                });
                                if (response.ok) {
                                    let url = `${this.urlBase}?Limit=${this.limit}&Pagina=${this.paginaActual}`;
                                    const data = await this.hacerPeticion(url);
                                    if (data) {
                                        this.actualizarDOM(data, this.paginaActual);
                                    }
                                    this.mostrarMensaje("Tipo Operacion eliminado");
                                } else {
                                    const { mensaje } = await response.json();
                                    this.mostrarMensaje(mensaje ?? "No se pudo eliminar", false);
                                }
                            }
                            catch {
                                this.mostrarMensaje("Error al eliminar el tipo de operación", false);
                            }
                            finally {
                                this.estaEliminando = false;
                            }
                        }
                    },
                    abrirFormModal(tipoOperacion) {
                        if (!tipoOperacion || tipoOperacion instanceof Event) {
                            this.tipoOperacion = { ...tipoOperacionDefault };
                        }
                        else {
                            this.tipoOperacion = { ...tipoOperacion };
                            this.estaEditando = true;
                        }
                        this.erroresTipoOperacion = { ...erroresTipoOperacionDefault };
                        if (!formModal)
                            formModal = new bootstrap.Modal(document.getElementById('modal_formulario_tipoOperacion'), {});
                        formModal.show();
                    },
                    cancelarEditar() {
                        this.estaEditando = false;
                        document.getElementById("app-tipoOperacion").focus();
                    },
                    async onSubmitTipoOperacion() {
                        if (!this.esFormularioValido())
                            return;
                        let url = this.urlBase;
                        const opcionesFetch = { 
                            method: "POST",
                            headers: { 
                                'Content-Type': 'application/json',
                                "Authorization": `Bearer ${sessionStorage.getItem("jwt")}`
                            },
                            body: JSON.stringify(this.tipoOperacion)
                        };
                        if (this.estaEditando) {
                            url += `/${this.tipoOperacion.id}`;
                            opcionesFetch.method = "PUT";
                        }
                        try {
                            this.estaGuardando = true;
                            const response = await fetch(url, opcionesFetch);
                            if (response.ok) {
                                const data = await response.json();
                                if (this.estaEditando) {
                                    const indiceTipoOperacionActualizado = this.tiposOperaciones.findIndex(c => c.id == data?.tipoOperacion.id);
                                    if (indiceTipoOperacionActualizado >= 0) {
                                        this.tiposOperaciones[indiceTipoOperacionActualizado] = data?.tipoOperacion;
                                    }
                                } else {
                                    url = `${this.urlBase}?Limit=${this.limit}&Pagina=${this.paginaActual}`;
                                    const data2 = await this.hacerPeticion(url);
                                    if (data2) {
                                        this.actualizarDOM(data2, this.paginaActual);
                                    }
                                }
                                if (formModal)
                                    formModal.hide();
                                this.mostrarMensaje(`Tipo de operación ${this.estaEditando ? "Actualizado" : "Guardado" }`);
                            } else {
                                const { mensaje, errors } = await response.json();
                                if (errors) {
                                    Object.keys(errors).forEach(e => {
                                        this.erroresTipoOperacion[e.toLowerCase()] = errors[e].join(", ");
                                    });
                                } else {
                                    this.mostrarMensaje(mensaje ?? "La petición no es correcta", false);
                                }
                            }
                        } catch {
                            this.mostrarMensaje(`Se produjo un error al ${this.estaEditando ? "Actualizar" : "Guardar" }`, false);
                        }
                        finally {
                            this.estaEditando = false;
                            this.estaGuardando = false;
                        }
                    },
                    esFormularioValido() {
                        const mapaValidador = new Map([
                            ["nombre", this.validarNombre],
                            ["costoFijo", this.validarPrecio]
                        ]);
                        const clavesAValidar = [...mapaValidador.keys()];
                        Object.keys(this.tipoOperacion)
                            .forEach(key => {
                                if (!clavesAValidar.includes(key)) return;
                                this.erroresTipoOperacion[key] = mapaValidador.get(key)(this.tipoOperacion[key]);
                            }
                        );
                        return !Object.keys(this.erroresTipoOperacion).some(v => this.erroresTipoOperacion[v]);
                    },
                    validarNombre(valor) {
                        if (!valor)
                            return "Es Requerido";
                        if (valor.length > 45)
                            return "Supera el límite de 45 caracteres";
                        return;
                    },
                    validarPrecio(valor) {
                        if (valor === undefined || typeof valor == "string")
                            return "Es Requerido";
                        const numero = Number(valor);
                        if (isNaN(numero))
                            return "Valor incorrecto";
                        if (numero <= 0)
                            return "Debe ser mayor a 0";
                        return;
                    },
                    limpiarFormulario() {
                        if (!this.estaEditando)
                            this.tipoOperacion = { ...tipoOperacionDefault };
                        else
                            this.tipoOperacion.costoFijo = "";
                        this.erroresTipoOperacion = { ...erroresTipoOperacionDefault };
                    },
                    mostrarMensaje(mensaje, ok = true) {
                        this.mensaje = mensaje;
                        this.esMensajeError = !ok;
                        if (!modalMensaje)
                            modalMensaje = new bootstrap.Modal(document.getElementById('modal-mensaje'), {});
                        modalMensaje.show();
                    },
                    inicializarTooltips() {
                        this.tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]');
                        this.tooltipList = [...this.tooltipTriggerList].map(tooltipTriggerEl => new bootstrap.Tooltip(tooltipTriggerEl));
                    },
                    formatearCostoFijo(cf) {
                        return `$ ${this.formateador.format(cf)}`;
                    }
                },
                mounted() {
                    if (@(hayMensajeError.ToString().ToLower())) {
                        this.mostrarMensaje("@ViewBag.MensajeError", false);
                    }
                    this.inicializarTooltips();
                }
            }).mount("#app-tipoOperacion");
        });
    </script>
}