@using System.Text.Json
@using metalurgicaMVC.Utils
@using metalurgicaMVC.ViewModels.UsuarioViewModels
@model EditUsuarioVM
@{
    ViewData["Title"] = "Editar Usuario";
    var serializationOptions = new JsonSerializerOptions {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase
    };
    bool hayMensajeError = !string.IsNullOrWhiteSpace(ViewBag.MensajeError);
}

<div id="app-edit-usuario" class="container-md mt-2" v-cloak>
    <h1 class="text-center display-4">Modificar Datos</h1>
    <div class="row mt-2 mb-3">
        <form 
            id="form-datos-usuario" 
            class="p-3 w-75 mx-auto border rounded-4 shadow-sm bg-light"
            @@submit.prevent="onSubmitUpdateDatosUsuario" 
            asp-antiforgery="true"
        >
            <span class="display-6">Editar Datos de Usuario</span>
            <div class="row mt-3 mb-md-4 pb-3 bg-light-subtle">
                <div class="col-12 col-md-6 mt-5 mt-md-1 mb-md-0">
                    <label asp-for="UpdateDatosVM.Username" class="form-label fw-bold">@Html.DisplayNameFor(model => model.UpdateDatosVM!.Username)</label>
                    <input 
                        type="text" 
                        asp-for="UpdateDatosVM.Username" 
                        v-model="editUsuario.username" 
                        class="form-control" 
                        :class="{ 'is-invalid': erroresEditUsuario.username }" 
                        id="username" 
                        aria-describedby="error_username"
                    >
                    <span 
                        asp-validation-for="UpdateDatosVM.Username" 
                        id="error_username" 
                        class="invalid-feedback" 
                        @* v-if="erroresEditUsuario.username" *@
                    >
                        {{ erroresEditUsuario.username }}
                    </span>
                </div>
                <div class="col-12 col-md-6 mt-5 mt-md-1 mb-md-0">
                    <label asp-for="UpdateDatosVM.Rol" class="form-label fw-bold">@Html.DisplayNameFor(model => model.UpdateDatosVM!.Rol)</label>
                    <select 
                        asp-for="UpdateDatosVM.Rol" 
                        id="rol" 
                        v-model="editUsuario.rol" 
                        class="form-select" 
                        :class="{ 'is-invalid': erroresEditUsuario.rol }" 
                        aria-describedby="error_rol"
                    >
                        <option value="@Rol.ADMIN" selected="@(Model.UpdateDatosVM!.Rol==Rol.ADMIN.ToString())">@Rol.ADMIN</option>
                        <option value="@Rol.EMPLEADO" selected="@(Model.UpdateDatosVM.Rol==Rol.EMPLEADO.ToString())">@Rol.EMPLEADO</option>
                    </select>
                    <span 
                        asp-validation-for="UpdateDatosVM.Rol" 
                        id="error_rol" 
                        class="invalid-feedback" 
                        @* v-if="erroresEditUsuario.rol" *@
                    >
                        {{ erroresEditUsuario.rol }}
                    </span>
                </div>
            </div>

            <div class="row mb-2 mt-5 mt-md-4 justify-content-center">
                <div class="col-2 d-flex justify-content-center">
                    <input type="submit" value="Guardar" class="btn btn-primary d-block mx-auto" :class="{ disabled: estaCargando }" :disabled="estaCargando">
                </div>
            </div>
        </form>
    </div>

    <div class="row mt-2 mb-3">
        <form 
            id="form-datos-usuario" 
            class="p-3 w-75 mx-auto border rounded-4 shadow-sm bg-light"
            @@submit.prevent="onSubmitUpdatePassword" 
            asp-antiforgery="true"
        >
            <span class="display-6">Cambiar Contraseña</span>
            <div class="row mt-3 mb-md-4 bg-light-subtle pb-3">
                <div class="col-12 col-md-6 mt-5 mt-md-1 mb-md-0">
                    <label asp-for="UpdatePasswordVM.PasswordNuevo" class="form-label fw-bold">
                        @Html.DisplayNameFor(model => model.UpdatePasswordVM!.PasswordNuevo)
                    </label>
                    <div class="input-group has-validation">
                        <input 
                            :type="passwordNuevoInputType"
                            asp-for="UpdatePasswordVM.PasswordNuevo"
                            v-model="editPassword.passwordNuevo" 
                            class="form-control" 
                            :class="{ 'is-invalid': erroresEditPassword.passwordNuevo }" 
                            id="nueva" 
                            aria-describedby="error_nueva"
                        >
                        <span class="input-group-text" id="inputGroupPrepend" @@click="mostrarOcultarPasssword('passwordNuevo')" style="cursor: pointer;">
                            <i 
                                id="i-password-nuevo"
                                class="bi text-secondary-subtle" 
                                :class="{ 'bi-eye': !mostrarPasswordNuevo, 'bi-eye-slash': mostrarPasswordNuevo }"
                                data-bs-toggle="tooltip" :data-bs-title="passwordNuevoTooltip"
                            ></i>
                        </span>
                        <span 
                            asp-validation-for="UpdatePasswordVM.PasswordNuevo" 
                            id="error_nueva"
                            class="invalid-feedback" 
                            @* v-if="erroresEditPassword.passwordNuevo" *@
                        >
                            {{ erroresEditPassword.passwordNuevo }}
                        </span>
                    </div>
                </div>
                <div class="col-12 col-md-6 mt-5 mt-md-1 mb-md-0">
                    <label asp-for="UpdatePasswordVM.PasswordActual" class="form-label fw-bold">
                        @Html.DisplayNameFor(model => model.UpdatePasswordVM!.PasswordActual)
                    </label>
                    <div class="input-group has-validation">
                        <input 
                            :type="passwordActualInputType" 
                            asp-for="UpdatePasswordVM.PasswordActual" 
                            v-model="editPassword.passwordActual" 
                            class="form-control" 
                            :class="{ 'is-invalid': erroresEditPassword.passwordActual }" 
                            id="actual"
                            aria-describedby="error_actual"
                        >
                        <span class="input-group-text" id="inputGroupPrepend" @@click="mostrarOcultarPasssword('passwordActual')" style="cursor: pointer;">
                            <i 
                                id="i-password-actual"
                                class="bi text-secondary-subtle" 
                                :class="{ 'bi-eye': !mostrarPasswordActual, 'bi-eye-slash': mostrarPasswordActual }"
                                data-bs-toggle="tooltip" :data-bs-title="passwordActualTooltip"
                            ></i>
                        </span>
                        <span 
                            asp-validation-for="UpdatePasswordVM.PasswordActual"  
                            id="error_actual"
                            class="invalid-feedback"
                            @* v-if="erroresEditPassword.passwordActual" *@
                        >
                            {{ erroresEditPassword.passwordActual }}
                        </span>
                    </div>
                </div>
            </div>
            <div class="row mb-2 mt-5 mt-md-4 justify-content-center">
                <div class="col-2 d-flex justify-content-center">
                    <input type="submit" value="Guardar" class="btn btn-primary d-block mx-auto" :class="{ disabled: estaCargando }" :disabled="estaCargando">
                </div>
            </div>
        </form>
    </div>

    @* <div class="row mt-2 mb-3">
        <div class="row bg-light w-75 mx-auto border rounded-4 shadow-sm px-0">
