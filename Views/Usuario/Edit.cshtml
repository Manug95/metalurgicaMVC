@section Scripts {
    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", _ => {
            const { createApp } = Vue;
            const editUsuarioDefault = { username: null, rol: null };
            const erroresEditUsuarioDefault = { username: null, rol: null };

            createApp({
                data() {
                    return {
                        usuarioId: @Model.Id,
                        urlBase: "/api/usuarios",
                        opcionesFetch: { 
                            method: "PATCH",
                            headers: { 
                                'Content-Type': 'application/json'
                            },
                            body: null
                        },
                        editUsuario: { username: "@Model.Username", rol: "@Model.Rol" },
                        erroresEditUsuario: { ...erroresEditUsuarioDefault },
                        mensaje: "",
                        esMensajeError: false,
                        mostrarPassword: false,
                        passwordInputType: "password",
                        passwordTooltip: "Mostrar Contraseña",
                        estaCargando: false
                    }
                },
                methods: {
                    mostrarMensaje(mensaje, ok = true) {
                        this.mensaje = mensaje;
                        this.esMensajeError = !ok;
                        const myModal = new bootstrap.Modal(document.getElementById('modal-mensaje'), {});
                        myModal.show();
                    },
                    async onSubmitUpdateDatosUsuario() {
                        this.estaCargando = true;
                        if (this.esFormularioEditValido()) {
                            let url = `${this.urlBase}/${this.usuarioId}`;
                            this.opcionesFetch.body = JSON.stringify(this.editUsuario);
                            this.opcionesFetch.headers['RequestVerificationToken'] = document.getElementsByName("__RequestVerificationToken")?.item(0)?.value;
                            try{
                                const response = await fetch(url, this.opcionesFetch);
                                if (response.ok) {
                                    @* const data = await response.json(); *@
                                    this.mostrarMensaje("Datos de Usuario Actualizados");
                                } else {
                                    const { mensaje, errors } = await response.json();
                                    if (errors) {
                                        Object.keys(errors).forEach(e => {
                                            this.erroresEditUsuario[e.toLowerCase()] = errors[e].join(", ");
                                        });
                                    } else {
                                        this.mostrarMensaje(mensaje ?? "La petición no es correcta", false);
                                    }
                                }
                            } catch {
                                this.mostrarMensaje("Se produjo un error al hacer la petición", false);
                            }
                        }
                        this.estaCargando = false;
                    },
                    esFormularioEditValido() {
                        const mapaValidador = new Map([
                            ["username", validarUsername],
                            ["rol", validarRol]
                        ]);
                        Object.keys(this.editUsuario)
                            .forEach(key => {
                                this.erroresEditUsuario[key] = mapaValidador.get(key)(this.editUsuario[key]);
                            }
                        );
                        return !Object.keys(this.erroresEditUsuario).some(v => this.erroresEditUsuario[v]);
                    }
                },
                mounted() {
                    if (@(hayMensajeError.ToString().ToLower())) {
                        this.mostrarMensaje("@ViewBag.MensajeError", false);
                    }
                }
            }).mount('#app-edit-usuario');

            function validarUsername(cadena) {
                if (!cadena)
                    return "El nombre de usuario no puede estar vacío";
                if (cadena.trim().length == 0)
                    return "El nombre de usuario no puede estar vacío";
                if (cadena.length > 20)
                    return "El máximo de carateres permitidos es 20";
                return;
            }

            function validarRol(valor) {
                if (!valor)
                    return "El rol es obligatorio";
                return;
            }
        });
    </script>
}