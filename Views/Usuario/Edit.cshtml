@using System.Text.Json
@using metalurgicaMVC.Utils
@using metalurgicaMVC.ViewModels.UsuarioViewModels
@model EditUsuarioVM
@{
    ViewData["Title"] = "Editar Usuario";
    var serializationOptions = new JsonSerializerOptions {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase
    };
    bool hayMensajeError = !string.IsNullOrWhiteSpace(ViewBag.MensajeError);
    string? userAvatar = Model.UpdateAvatarVM!.Avatar?.Replace("\\", "/");
}

<div id="app-edit-usuario" class="container-md mt-2" v-cloak>
    <h1 class="text-center display-4">Modificar Datos</h1>
    <div class="row mt-2 mb-3">
        <form 
            id="form-datos-usuario" 
            class="p-3 w-75 mx-auto border rounded-4 shadow-sm bg-light"
            @@submit.prevent="onSubmitUpdateDatosUsuario" 
            asp-antiforgery="true"
        >
            <span class="display-6">Editar Datos de Usuario</span>
            <div class="row mt-3 mb-md-4 pb-3 bg-light-subtle">
                <div class="col-12 col-md-6 mt-5 mt-md-1 mb-md-0">
                    <label asp-for="UpdateDatosVM.Username" class="form-label fw-bold">@Html.DisplayNameFor(model => model.UpdateDatosVM!.Username)</label>
                    <input 
                        type="text" 
                        asp-for="UpdateDatosVM.Username" 
                        v-model="editUsuario.username" 
                        class="form-control" 
                        :class="{ 'is-invalid': erroresEditUsuario.username }" 
                        id="username" 
                        aria-describedby="error_username"
                    >
                    <span 
                        asp-validation-for="UpdateDatosVM.Username" 
                        id="error_username" 
                        class="ps-1 invalid-feedback" 
                        @* v-if="erroresEditUsuario.username" *@
                    >
                        {{ erroresEditUsuario.username }}
                    </span>
                </div>
                <div class="col-12 col-md-6 mt-5 mt-md-1 mb-md-0">
                    <label asp-for="UpdateDatosVM.Rol" class="form-label fw-bold">@Html.DisplayNameFor(model => model.UpdateDatosVM!.Rol)</label>
                    <select 
                        asp-for="UpdateDatosVM.Rol" 
                        id="rol" 
                        v-model="editUsuario.rol" 
                        class="form-select" 
                        :class="{ 'is-invalid': erroresEditUsuario.rol }" 
                        aria-describedby="error_rol"
                    >
                        <option value="@Rol.ADMIN" selected="@(Model.UpdateDatosVM!.Rol==Rol.ADMIN.ToString())">@Rol.ADMIN</option>
                        <option value="@Rol.EMPLEADO" selected="@(Model.UpdateDatosVM.Rol==Rol.EMPLEADO.ToString())">@Rol.EMPLEADO</option>
                    </select>
                    <span 
                        asp-validation-for="UpdateDatosVM.Rol" 
                        id="error_rol" 
                        class="ps-1 invalid-feedback" 
                        @* v-if="erroresEditUsuario.rol" *@
                    >
                        {{ erroresEditUsuario.rol }}
                    </span>
                </div>
            </div>

            <div class="row mb-2 mt-5 mt-md-4 justify-content-center">
                <div class="col-2 d-flex justify-content-center">
                    <button type="submit" class="btn btn-primary d-block mx-auto" :class="{ disabled: estaCargando }" :disabled="estaCargando">
                        <i class="bi bi-floppy"></i> Guardar
                    </button>
                </div>
            </div>
        </form>
    </div>

    <div class="row mt-2 mb-3">
        <form 
            id="form-datos-usuario" 
            class="p-3 w-75 mx-auto border rounded-4 shadow-sm bg-light"
            @@submit.prevent="onSubmitUpdatePassword" 
            asp-antiforgery="true"
        >
            <span class="display-6">Cambiar Contraseña</span>
            <div class="row mt-3 mb-md-4 bg-light-subtle pb-3">
                <div class="col-12 col-md-6 mt-5 mt-md-1 mb-md-0">
                    <label asp-for="UpdatePasswordVM.PasswordNuevo" class="form-label fw-bold">
                        @Html.DisplayNameFor(model => model.UpdatePasswordVM!.PasswordNuevo)
                    </label>
                    <div class="input-group has-validation">
                        <input 
                            :type="passwordNuevoInputType"
                            asp-for="UpdatePasswordVM.PasswordNuevo"
                            v-model="editPassword.passwordNuevo" 
                            class="form-control" 
                            :class="{ 'is-invalid': erroresEditPassword.passwordNuevo }" 
                            id="nueva" 
                            aria-describedby="error_nueva"
                        >
                        <span class="input-group-text" id="inputGroupPrepend" @@click="mostrarOcultarPasssword('passwordNuevo')" style="cursor: pointer;">
                            <i 
                                id="i-password-nuevo"
                                class="bi text-secondary-subtle" 
                                :class="{ 'bi-eye': !mostrarPasswordNuevo, 'bi-eye-slash': mostrarPasswordNuevo }"
                                data-bs-toggle="tooltip" :data-bs-title="passwordNuevoTooltip"
                            ></i>
                        </span>
                        <span 
                            asp-validation-for="UpdatePasswordVM.PasswordNuevo" 
                            id="error_nueva"
                            class="ps-1 invalid-feedback" 
                            @* v-if="erroresEditPassword.passwordNuevo" *@
                        >
                            {{ erroresEditPassword.passwordNuevo }}
                        </span>
                    </div>
                </div>
                <div class="col-12 col-md-6 mt-5 mt-md-1 mb-md-0">
                    <label asp-for="UpdatePasswordVM.PasswordActual" class="form-label fw-bold">
                        @Html.DisplayNameFor(model => model.UpdatePasswordVM!.PasswordActual)
                    </label>
                    <div class="input-group has-validation">
                        <input 
                            :type="passwordActualInputType" 
                            asp-for="UpdatePasswordVM.PasswordActual" 
                            v-model="editPassword.passwordActual" 
                            class="form-control" 
                            :class="{ 'is-invalid': erroresEditPassword.passwordActual }" 
                            id="actual"
                            aria-describedby="error_actual"
                        >
                        <span class="input-group-text" id="inputGroupPrepend" @@click="mostrarOcultarPasssword('passwordActual')" style="cursor: pointer;">
                            <i 
                                id="i-password-actual"
                                class="bi text-secondary-subtle" 
                                :class="{ 'bi-eye': !mostrarPasswordActual, 'bi-eye-slash': mostrarPasswordActual }"
                                data-bs-toggle="tooltip" :data-bs-title="passwordActualTooltip"
                            ></i>
                        </span>
                        <span 
                            asp-validation-for="UpdatePasswordVM.PasswordActual"  
                            id="error_actual"
                            class="ps-1 invalid-feedback"
                            @* v-if="erroresEditPassword.passwordActual" *@
                        >
                            {{ erroresEditPassword.passwordActual }}
                        </span>
                    </div>
                </div>
            </div>
            <div class="row mb-2 mt-5 mt-md-4 justify-content-center">
                <div class="col-2 d-flex justify-content-center">
                    <button type="submit" class="btn btn-primary d-block mx-auto" :class="{ disabled: estaCargando }" :disabled="estaCargando">
                        <i class="bi bi-floppy"></i> Guardar
                    </button>
                </div>
            </div>
        </form>
    </div>

    <div class="row mt-2 mb-3">
        <div class="row bg-light w-75 mx-auto border rounded-4 shadow-sm px-0">
            <div 
                class="col-12 mt-5 mt-md-1 mb-md-0 px-1 pt-2"
                :class="{ 'col-md-8': editAvatar.avatar }"
            >
                <span class="display-6 ps-3">Editar Foto de Perfil</span>
                <form 
                    id="form-avatar-usuario" 
                    class="mt-2 mb-3 bg-light-subtle"
                    @@submit.prevent="onSubmitUpdateAvatar" 
                    asp-antiforgery="true"
                >
                    <div class="p-3">
                        <label asp-for="UpdateAvatarVM.AvatarFile" class="form-label fw-bold">
                            @Html.DisplayNameFor(model => model.UpdateAvatarVM!.Avatar)
                        </label>
                        <input 
                            id="avatarFile" 
                            type="file" 
                            asp-for="UpdateAvatarVM.AvatarFile" 
                            @@change="alSeleccionarArchivo" 
                            class="form-control" 
                            :class="{ 'is-invalid': erroresEditAvatar.avatarFile }" 
                            accept="image/*"
                            aria-describedby="error_avatarFile" 
                        >
                        <span 
                            asp-validation-for="UpdateAvatarVM.AvatarFile" 
                            id="error_avatarFile"
                            class="ps-1 invalid-feedback"
                            @* v-if="erroresEditAvatar.avatarFile" *@
                        >
                            {{ erroresEditAvatar.avatarFile }}
                        </span>
                    </div>
                    <button type="submit" class="btn btn-primary d-block mx-auto mt-4" :class="{ disabled: estaCargando }" :disabled="estaCargando">
                        <i class="bi bi-floppy"></i> Guardar
                    </button>
                </form>
            </div>
            <div 
                class="col-12 col-md-4 mt-2 mb-3 pt-2 bg-light-subtle d-flex flex-column justify-content-evenly align-items-center" 
                v-if="editAvatar.avatar"
            >
                <img 
                    :src="editAvatar.avatar" 
                    alt="" 
                    width="64" 
                    class="rounded-circle" 
                    data-bs-toggle="tooltip" data-bs-title="Mi Avatar"
                />
                <button type="button" class="btn btn-danger btn-sm" @@click="eliminarAvatar">
                    <i class="bi bi-trash"></i> Eliminar
                </button>
            </div>
        </div>
    </div>
    <partial name="_ModalMensaje"/>
</div>

@section Scripts {
    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", _ => {
            const { createApp } = Vue;
            const editUsuarioDefault = { username: null, rol: null };
            const erroresEditUsuarioDefault = { username: null, rol: null };
            const editPasswordDefault = { passwordActual: null, passwordNuevo: null };
            const erroresEditPasswordDefault = { passwordActual: null, passwordNuevo: null };
            const editAvatarDefault = { avatarFile: null, avatar: "@userAvatar" };
            const erroresEditAvatarDefault = { avatarFile: null };

            createApp({
                data() {
                    return {
                        usuarioId: @Model.Id,
                        urlBase: "/api/usuarios",
                        opcionesFetch: { 
                            method: "PATCH",
                            headers: { 
                                'Content-Type': 'application/json'
                            },
                            body: null
                        },
                        editUsuario: { username: "@Model.UpdateDatosVM!.Username", rol: "@Model.UpdateDatosVM!.Rol" },
                        erroresEditUsuario: { ...erroresEditUsuarioDefault },
                        editPassword: { ...editPasswordDefault },
                        erroresEditPassword: { ...erroresEditPasswordDefault },
                        editAvatar: { ...editAvatarDefault },
                        erroresEditAvatar: { ...erroresEditAvatarDefault },
                        mensaje: "",
                        esMensajeError: false,
                        mostrarPassword: false,
                        passwordInputType: "password",
                        passwordTooltip: "Mostrar Contraseña",
                        estaCargando: false,
                        mostrarPasswordNuevo: false,
                        passwordNuevoInputType: "password",
                        passwordNuevoTooltip: "Mostrar Contraseña",
                        mostrarPasswordActual: false,
                        passwordActualInputType: "password",
                        passwordActualTooltip: "Mostrar Contraseña"
                    }
                },
                methods: {
                    mostrarMensaje(mensaje, ok = true) {
                        this.mensaje = mensaje;
                        this.esMensajeError = !ok;
                        const myModal = new bootstrap.Modal(document.getElementById('modal-mensaje'), {});
                        myModal.show();
                    },
                    async onSubmitUpdateDatosUsuario() {
                        this.estaCargando = true;
                        if (this.esFormularioEditValido()) {
                            let url = `${this.urlBase}/${this.usuarioId}`;
                            this.opcionesFetch.body = JSON.stringify(this.editUsuario);
                            this.opcionesFetch.headers['RequestVerificationToken'] = document.getElementsByName("__RequestVerificationToken")?.item(0)?.value;
                            try{
                                const response = await fetch(url, this.opcionesFetch);
                                if (response.ok) {
                                    @* const data = await response.json(); *@
                                    this.mostrarMensaje("Datos de Usuario Actualizados");
                                } else {
                                    const { mensaje, errors } = await response.json();
                                    if (errors) {
                                        Object.keys(errors).forEach(e => {
                                            this.erroresEditUsuario[e.toLowerCase()] = errors[e].join(", ");
                                        });
                                    } else {
                                        this.mostrarMensaje(mensaje ?? "La petición no es correcta", false);
                                    }
                                }
                            } catch {
                                this.mostrarMensaje("Se produjo un error al hacer la petición", false);
                            }
                        }
                        this.estaCargando = false;
                    },
                    esFormularioEditValido() {
                        const mapaValidador = new Map([
                            ["username", validarUsername],
                            ["rol", validarRol]
                        ]);
                        Object.keys(this.editUsuario)
                            .forEach(key => {
                                this.erroresEditUsuario[key] = mapaValidador.get(key)(this.editUsuario[key]);
                            }
                        );
                        return !Object.keys(this.erroresEditUsuario).some(v => this.erroresEditUsuario[v]);
                    },
                    async onSubmitUpdatePassword() {
                        this.estaCargando = true;
                        if (this.esFormularioEditPasswordValido()) {
                            let url = `${this.urlBase}/password/${this.usuarioId}`;
                            this.opcionesFetch.body = JSON.stringify(this.editPassword);
                            this.opcionesFetch.headers['RequestVerificationToken'] = document.getElementsByName("__RequestVerificationToken")?.item(1)?.value;
                            try{
                                const response = await fetch(url, this.opcionesFetch);
                                if (response.ok) {
                                    @* const data = await response.json(); *@
                                    this.editPassword = { ...editPasswordDefault };
                                    this.mostrarMensaje("Contraseña Actualizada");
                                } else {
                                    const { mensaje, errors } = await response.json();
                                    if (errors) {
                                        Object.keys(errors).forEach(e => {
                                            this.erroresEditPassword[e[0].toLowerCase()+e.substring(1)] = errors[e].join(", ");
                                        });
                                    } else {
                                        this.mostrarMensaje(mensaje ?? "La petición no es correcta", false);
                                    }
                                }
                            } catch {
                                this.mostrarMensaje("Se produjo un error al hacer la petición", false);
                            }
                        }
                        this.estaCargando = false;
                    },
                    esFormularioEditPasswordValido() {
                        const mapaValidador = new Map([
                            ["passwordNuevo", validarPasswordNuevo],
                            ["passwordActual", validarPasswordActual]
                        ]);
                        Object.keys(this.editPassword)
                            .forEach(key => {
                                this.erroresEditPassword[key] = mapaValidador.get(key)(this.editPassword[key]);
                            }
                        );
                        return !Object.keys(this.erroresEditPassword).some(v => this.erroresEditPassword[v]);
                    },
                    alSeleccionarArchivo(event) {
                        const archivos = event.target.files;
                        if (archivos.length > 0) 
                            this.editAvatar.avatarFile = archivos[0];
                        else 
                            this.archivo = null;
                    },
                    async onSubmitUpdateAvatar() {
                        this.estaCargando = true;
                        if (!this.esFormularioEditAvatarValido()) {
                            this.estaCargando = false;
                            return;
                        }
                        let url = `${this.urlBase}/avatar/${this.usuarioId}`;
                        const formData = new FormData();
                        formData.append('avatarFile', this.editAvatar.avatarFile);
                        const opFectch = { ...this.opcionesFetch };
                        delete opFectch.headers['Content-Type'];
                        opFectch.body = formData;
                        opFectch.headers['RequestVerificationToken'] = document.getElementsByName("__RequestVerificationToken")?.item(2)?.value;
                        try{
                            const response = await fetch(url, opFectch);
                            if (response.ok) {
                                const { avatar } = await response.json();
                                this.editAvatar = { avatarFile: null, avatar };
                                this.erroresEditAvatar = { ...erroresEditAvatarDefault };
                                this.mostrarMensaje("Foto de Perfil Actualizada");
                            } else {
                                const { mensaje, errors } = await response.json();
                                if (errors) {
                                    Object.keys(errors).forEach(e => {
                                        this.erroresEditAvatar[e[0].toLowerCase()+e.substring(1)] = errors[e].join(", ");
                                    });
                                } else {
                                    this.mostrarMensaje(mensaje ?? "La petición no es correcta", false);
                                }
                            }
                        } catch {
                            this.mostrarMensaje("Se produjo un error al hacer la petición", false);
                        }
                        this.estaCargando = false;
                    },
                    esFormularioEditAvatarValido() {
                        const extensionesVálidas = ["jpg", "jpeg", "png", "gif", "webp"];
                        if (!this.editAvatar.avatarFile) {
                            this.erroresEditAvatar.avatarFile = "No se cargo una imagen";
                            return false;
                        }
                        if (!extensionesVálidas.includes(this.editAvatar.avatarFile.name.split(".")[1])) {
                            this.erroresEditAvatar.avatarFile = "El archivo tiene una extensión no permitida";
                            return false;
                        }
                        if (this.editAvatar.avatarFile.size > 5*1024*1024) {
                            this.erroresEditAvatar.avatarFile = "La imagen no puede pesar más de 5 MB";
                            return false;
                        }
                        return true;
                    },
                    async eliminarAvatar() {
                        this.estaCargando = true;
                        try{
                            let url = `${this.urlBase}/avatar/${this.usuarioId}`;
                            const response = await fetch(url, { method: "DELETE" });
                            if (response.ok) {
                                this.editAvatar.avatar = null;
                                this.mostrarMensaje("Foto de Perfil Eliminada");
                            } else {
                                const { mensaje, errors } = await response.json();
                                if (errors) {
                                    errors.forEach(e => {
                                        this.erroresEditAvatar[e[0].toLowerCase()+e.substring(1)] = errors[e].join(", ");
                                    });
                                }
                                this.mostrarMensaje(mensaje ?? "La petición no es correcta", false);
                            }
                        } catch {
                            this.mostrarMensaje("Se produjo un error al hacer la petición", false);
                        }
                        this.estaCargando = false;
                    },
                    mostrarOcultarPasssword(clavePasswrod) {
                        const clave = `mostrarP${clavePasswrod.slice(1)}`;
                        this[clave] = !this[clave];
                        if (this[clave]) {
                            this.mostrarPasswordFn(clavePasswrod);
                        }
                        else {
                            this.ocultarPassswordFn(clavePasswrod);
                        }
                    },
                    mostrarPasswordFn(clavePasswrod) {
                        this[`${clavePasswrod}InputType`] = "text";
                        this[`${clavePasswrod}Tooltip`] = "Ocultar Contraseña";
                        tooltipList[tooltipList
                            .findIndex(t => t._element.id == `i-password-${clavePasswrod == "passwordActual" ? "actual" : "nuevo"}`)]
                            .setContent({ '.tooltip-inner': this[`${clavePasswrod}Tooltip`] });
                    },
                    ocultarPassswordFn(clavePasswrod) {
                        this.mostrarPassword = false;
                        this[`${clavePasswrod}InputType`] = "password";
                        this[`${clavePasswrod}Tooltip`] = "Mostrar Contraseña";
                        tooltipList[tooltipList
                            .findIndex(t => t._element.id == `i-password-${clavePasswrod == "passwordActual" ? "actual" : "nuevo"}`)]
                            .setContent({ '.tooltip-inner': this[`${clavePasswrod}Tooltip`] });
                    }
                },
                mounted() {
                    if (@(hayMensajeError.ToString().ToLower())) {
                        this.mostrarMensaje("@ViewBag.MensajeError", false);
                    }
                }
            }).mount('#app-edit-usuario');

            const tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]');
            const tooltipList = [...tooltipTriggerList].map(tooltipTriggerEl => new bootstrap.Tooltip(tooltipTriggerEl));
        });

        function validarUsername(valor) {
            if (!valor)
                return "El nombre de usuario no puede estar vacío";
            if (valor.trim().length == 0)
                return "El nombre de usuario no puede estar vacío";
            if (valor.length > 20)
                return "El máximo de carateres permitidos es 20";
            return;
        }

        function validarRol(valor) {
            if (!valor)
                return "El rol es obligatorio";
            return;
        }

        function validarPasswordNuevo(valor) {
            if (!valor)
                return "No ingresó la contraseña nueva";
            if (valor.trim().length == 0)
                return "No ingresó la contraseña nueva";
            if (valor.length < 8)
                return "La contraseña debe tener al menos 8 caracteres";
            return;
        }

        function validarPasswordActual(valor) {
            if (!valor)
                return "No ingresó la contraseña actual";
            if (valor.trim().length == 0)
                return "No ingresó la contraseña actual";
            return;
        }
    </script>
}