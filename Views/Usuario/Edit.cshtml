                    <legend class="ps-3">Cambiar el Avatar</legend>
                    <div class="border rounded-4 shadow-sm p-3">
                        <label asp-for="AvatarFile" class="form-label fw-bold">Avatar</label>
                        <input type="file" asp-for="AvatarFile" class="form-control" id="Avatar" accept="image/*">
                        <span asp-validation-for="AvatarFile" class="text-danger small"></span>
                    </div>
                    <input type="hidden" asp-for="Id"/>
                    <input type="submit" value="Guardar" class="btn btn-primary d-block mx-auto mt-3">
                </form>
            </div>
            @if(!string.IsNullOrWhiteSpace(Model.Avatar)){
                <div class="col-12 col-md-4 mt-2 mb-3 bg-light-subtle d-flex justify-content-evenly align-items-center">
                    <img src="@Model.Avatar" alt="" width="48" class="rounded-circle" data-bs-toggle="tooltip" data-bs-title="Mi Avatar"/>
