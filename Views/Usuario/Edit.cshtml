@using System.Text.Json
@using metalurgicaMVC.Utils
@using metalurgicaMVC.ViewModels
@model EditUsuarioVM
@{
    ViewData["Title"] = "Editar Usuario";
    var serializationOptions = new JsonSerializerOptions {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase
    };
    bool hayMensajeError = !string.IsNullOrWhiteSpace(ViewBag.MensajeError);
}

<div id="app-edit-usuario" class="container-md mt-2" v-cloak>
    <h1 class="text-center display-4">Modificar Datos</h1>
    <div class="row mt-2 mb-3">
        <form 
            id="form-datos-usuario" 
            class="p-3 w-75 mx-auto border rounded-4 shadow-sm bg-light"
            @@submit.prevent="onSubmitUpdateDatosUsuario" 
            asp-antiforgery="true"
        >
            <span class="display-6">Editar Datos de Usuario</span>
            <div class="row mt-3 mb-md-4 pb-3 bg-light-subtle">
                <div class="col-12 col-md-6 mt-5 mt-md-1 mb-md-0">
                    <label asp-for="Username" class="form-label fw-bold">@Html.DisplayNameFor(model => model.Username)</label>
                    <input 
                        type="text" 
                        asp-for="Username" 
                        v-model="editUsuario.username" 
                        class="form-control" 
                        :class="{ 'is-invalid': erroresEditUsuario.username }" 
                        id="username" 
                        aria-describedby="error_username"
                    >
                    <span 
                        asp-validation-for="Username" 
                        id="error_username" 
                        class="invalid-feedback" 
                        @* v-if="erroresEditUsuario.username" *@
                    >
                        {{ erroresEditUsuario.username }}
                    </span>
                </div>
                <div class="col-12 col-md-6 mt-5 mt-md-1 mb-md-0">
                    <label asp-for="Rol" class="form-label fw-bold">@Html.DisplayNameFor(model => model.Rol)</label>
                    <select 
                        asp-for="Rol" 
                        id="rol" 
                        v-model="editUsuario.rol" 
                        class="form-select" 
                        :class="{ 'is-invalid': erroresEditUsuario.rol }" 
                        aria-describedby="error_rol"
                    >
                        <option value="@Rol.ADMIN" selected="@(Model.Rol==Rol.ADMIN.ToString())">@Rol.ADMIN</option>
                        <option value="@Rol.EMPLEADO" selected="@(Model.Rol==Rol.EMPLEADO.ToString())">@Rol.EMPLEADO</option>
                    </select>
                    <span 
                        asp-validation-for="Rol" 
                        id="error_rol" 
                        class="invalid-feedback" 
                        @* v-if="erroresEditUsuario.rol" *@
                    >
                        {{ erroresEditUsuario.rol }}
                    </span>
                </div>
            </div>

            <div class="row mb-2 mt-5 mt-md-4 justify-content-center">
                <div class="col-2 d-flex justify-content-center">
                    <input type="submit" value="Guardar" class="btn btn-primary d-block mx-auto" :class="{ disabled: estaCargando }" :disabled="estaCargando">
                </div>
            </div>
        </form>
    </div>

