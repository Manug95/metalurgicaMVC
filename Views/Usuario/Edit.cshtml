    </div> *@
    <partial name="_ModalMensaje"/>
</div>

@section Scripts {
    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", _ => {
            const { createApp } = Vue;
            const editUsuarioDefault = { username: null, rol: null };
            const erroresEditUsuarioDefault = { username: null, rol: null };
            const editPasswordDefault = { passwordActual: null, passwordNuevo: null };
            const erroresEditPasswordDefault = { passwordActual: null, passwordNuevo: null };

            createApp({
                data() {
                    return {
                        usuarioId: @Model.Id,
                        urlBase: "/api/usuarios",
                        opcionesFetch: { 
                            method: "PATCH",
                            headers: { 
                                'Content-Type': 'application/json'
                            },
                            body: null
                        },
                        editUsuario: { username: "@Model.UpdateDatosVM!.Username", rol: "@Model.UpdateDatosVM!.Rol" },
                        erroresEditUsuario: { ...erroresEditUsuarioDefault },
                        editPassword: { ...editPasswordDefault },
                        erroresEditPassword: { ...erroresEditPasswordDefault },
                        mensaje: "",
                        esMensajeError: false,
                        mostrarPassword: false,
                        passwordInputType: "password",
                        passwordTooltip: "Mostrar Contraseña",
                        estaCargando: false,
                        mostrarPasswordNuevo: false,
                        passwordNuevoInputType: "password",
                        passwordNuevoTooltip: "Mostrar Contraseña",
                        mostrarPasswordActual: false,
                        passwordActualInputType: "password",
                        passwordActualTooltip: "Mostrar Contraseña"
                    }
                },
                methods: {
                    mostrarMensaje(mensaje, ok = true) {
                        this.mensaje = mensaje;
                        this.esMensajeError = !ok;
                        const myModal = new bootstrap.Modal(document.getElementById('modal-mensaje'), {});
                        myModal.show();
                    },
                    async onSubmitUpdateDatosUsuario() {
                        this.estaCargando = true;
                        if (this.esFormularioEditValido()) {
                            let url = `${this.urlBase}/${this.usuarioId}`;
                            this.opcionesFetch.body = JSON.stringify(this.editUsuario);
                            this.opcionesFetch.headers['RequestVerificationToken'] = document.getElementsByName("__RequestVerificationToken")?.item(0)?.value;
                            try{
                                const response = await fetch(url, this.opcionesFetch);
                                if (response.ok) {
                                    @* const data = await response.json(); *@
                                    this.mostrarMensaje("Datos de Usuario Actualizados");
                                } else {
                                    const { mensaje, errors } = await response.json();
                                    if (errors) {
                                        Object.keys(errors).forEach(e => {
                                            this.erroresEditUsuario[e.toLowerCase()] = errors[e].join(", ");
                                        });
                                    } else {
                                        this.mostrarMensaje(mensaje ?? "La petición no es correcta", false);
                                    }
                                }
                            } catch {
                                this.mostrarMensaje("Se produjo un error al hacer la petición", false);
                            }
                        }
                        this.estaCargando = false;
                    },
                    esFormularioEditValido() {
                        const mapaValidador = new Map([
                            ["username", validarUsername],
                            ["rol", validarRol]
                        ]);
                        Object.keys(this.editUsuario)
                            .forEach(key => {
                                this.erroresEditUsuario[key] = mapaValidador.get(key)(this.editUsuario[key]);
                            }
                        );
                        return !Object.keys(this.erroresEditUsuario).some(v => this.erroresEditUsuario[v]);
                    },
                    async onSubmitUpdatePassword() {
                        this.estaCargando = true;
                        if (this.esFormularioEditPasswordValido()) {
                            let url = `${this.urlBase}/password/${this.usuarioId}`;
                            this.opcionesFetch.body = JSON.stringify(this.editPassword);
                            this.opcionesFetch.headers['RequestVerificationToken'] = document.getElementsByName("__RequestVerificationToken")?.item(1)?.value;
                            try{
                                const response = await fetch(url, this.opcionesFetch);
                                if (response.ok) {
                                    @* const data = await response.json(); *@
                                    this.editPassword = { ...editPasswordDefault };
                                    this.mostrarMensaje("Contraseña Actualizada");
                                } else {
                                    const { mensaje, errors } = await response.json();
                                    if (errors) {
                                        Object.keys(errors).forEach(e => {
                                            this.erroresEditPassword[e.toLowerCase()] = errors[e].join(", ");
                                        });
                                    } else {
                                        this.mostrarMensaje(mensaje ?? "La petición no es correcta", false);
                                    }
                                }
                            } catch {
                                this.mostrarMensaje("Se produjo un error al hacer la petición", false);
                            }
                        }
                        this.estaCargando = false;
                    },
                    esFormularioEditPasswordValido() {
                        const mapaValidador = new Map([
                            ["passwordNuevo", validarPasswordNuevo],
                            ["passwordActual", validarPasswordActual]
                        ]);
                        Object.keys(this.editPassword)
                            .forEach(key => {
                                this.erroresEditPassword[key] = mapaValidador.get(key)(this.editPassword[key]);
                            }
                        );
                        return !Object.keys(this.erroresEditPassword).some(v => this.erroresEditPassword[v]);
                    },
                    mostrarOcultarPasssword(clavePasswrod) {
                        const clave = `mostrarP${clavePasswrod.slice(1)}`;
                        this[clave] = !this[clave];
                        if (this[clave]) {
                            this.mostrarPasswordFn(clavePasswrod);
                        }
                        else {
                            this.ocultarPassswordFn(clavePasswrod);
                        }
                    },
                    mostrarPasswordFn(clavePasswrod) {
                        this[`${clavePasswrod}InputType`] = "text";
                        this[`${clavePasswrod}Tooltip`] = "Ocultar Contraseña";
                        tooltipList[tooltipList
                            .findIndex(t => t._element.id == `i-password-${clavePasswrod == "passwordActual" ? "actual" : "nuevo"}`)]
                            .setContent({ '.tooltip-inner': this[`${clavePasswrod}Tooltip`] });
                    },
                    ocultarPassswordFn(clavePasswrod) {
                        this.mostrarPassword = false;
                        this[`${clavePasswrod}InputType`] = "password";
                        this[`${clavePasswrod}Tooltip`] = "Mostrar Contraseña";
                        tooltipList[tooltipList
                            .findIndex(t => t._element.id == `i-password-${clavePasswrod == "passwordActual" ? "actual" : "nuevo"}`)]
                            .setContent({ '.tooltip-inner': this[`${clavePasswrod}Tooltip`] });
                    }
                },
                mounted() {
                    if (@(hayMensajeError.ToString().ToLower())) {
                        this.mostrarMensaje("@ViewBag.MensajeError", false);
                    }
                }
            }).mount('#app-edit-usuario');

            const tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]');
            const tooltipList = [...tooltipTriggerList].map(tooltipTriggerEl => new bootstrap.Tooltip(tooltipTriggerEl));
        });

        function validarUsername(valor) {
            if (!valor)
                return "El nombre de usuario no puede estar vacío";
            if (valor.trim().length == 0)
                return "El nombre de usuario no puede estar vacío";
            if (valor.length > 20)
                return "El máximo de carateres permitidos es 20";
            return;
        }

        function validarRol(valor) {
            if (!valor)
                return "El rol es obligatorio";
            return;
        }

        function validarPasswordNuevo(valor) {
            if (!valor)
                return "No ingresó la contraseña nueva";
            if (valor.trim().length == 0)
                return "No ingresó la contraseña nueva";
            if (valor.length < 8)
                return "La contraseña debe tener al menos 8 caracteres";
            return;
        }

        function validarPasswordActual(valor) {
            if (!valor)
                return "No ingresó la contraseña actual";
            if (valor.trim().length == 0)
                return "No ingresó la contraseña actual";
            return;
        }
    </script>
}