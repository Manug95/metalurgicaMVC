@using metalurgicaMVC.Utils
@using metalurgicaMVC.ViewModels.UsuarioViewModels
@model UsuarioVM

<div id="modal_formulario_usuario" class="modal fade" tabindex="-1" aria-describedby="titulo-modal">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-light-subtle">
            <div class="modal-header">
                <div id="titulo-modal" class="modal-title fs-5">Registrar Nuevo Usuario</div>
                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body justify-content-center align-items-center">
                <div class="container-md">
                    <div class="d-flex justify-content-center align-items-center vh-50 w-100">
                        <form 
                            id="form-usuario" 
                            @@submit.prevent="onSubmitUsuario" 
                            class="p-3 w-100 mx-auto border rounded-4 needs-validation bg-light" 
                            asp-antiforgery="true"
                            novalidate
                        >

                            <div class="row mb-md-4">
                                <div class="col-12 mt-5 mt-md-3 mb-md-0">
                                    <label asp-for="Username" class="form-label fw-bold">
                                        @Html.DisplayNameFor(model => model.Username)
                                        <span class="text-danger">*</span>
                                    </label>
                                    <input 
                                        type="text" 
                                        asp-for="Username" 
                                        v-model="usuario.username" 
                                        class="form-control" 
                                        :class="{ 'is-invalid': erroresUsuario.username }" 
                                        id="username" 
                                        aria-describedby="error_username"
                                    >
                                    <div id="error_username" class="invalid-feedback" v-if="erroresUsuario.username">{{ erroresUsuario.username }}</div>
                                </div>
                            </div>

                            <div class="row mb-md-4">
                                <div class="col-12 mt-5 mt-md-3 mb-md-0">
                                    <label asp-for="Password" class="form-label fw-bold">
                                        @Html.DisplayNameFor(model => model.Password)
                                        <span class="text-danger">*</span>
                                    </label>
                                    <div class="input-group has-validation">
                                        <input 
                                            :type="passwordInputType" 
                                            asp-for="Password" 
                                            v-model="usuario.password" 
                                            class="form-control" 
                                            :class="{ 'is-invalid': erroresUsuario.password }" 
                                            id="password" 
                                            aria-describedby="error_password"
                                        >
                                        <span class="input-group-text" id="inputGroupPrepend" @@click="mostrarOcultarPasssword" style="cursor: pointer;">
                                            <i 
                                                id="i-password"
                                                class="bi text-secondary" 
                                                :class="{ 'bi-eye': !mostrarPassword, 'bi-eye-slash': mostrarPassword }"
                                                data-bs-toggle="tooltip" :data-bs-title="passwordTooltip"
                                            ></i>
                                        </span>
                                        <div id="error_password" class="invalid-feedback" v-if="erroresUsuario.password">{{ erroresUsuario.password }}</div>
                                    </div>
                                </div>
                            </div>

                            <div class="row mb-md-4">
                                <div class="col-12 mt-5 mt-md-3 mb-md-0">
                                    <label asp-for="Rol" class="form-label fw-bold">
                                        @Html.DisplayNameFor(model => model.Rol)
                                        <span class="text-danger">*</span>
                                    </label>
                                    <select 
                                        asp-for="Rol" 
                                        id="rol" 
                                        v-model="usuario.rol" 
                                        class="form-select" 
                                        :class="{ 'is-invalid': erroresUsuario.rol }" 
                                        aria-describedby="error_rol"
                                    >
                                        <option value="" selected>Seleccionar rol</option>
                                        <option value="@Rol.ADMIN" selected>@Rol.ADMIN</option>
                                        <option value="@Rol.EMPLEADO" selected>@Rol.EMPLEADO</option>
                                    </select>
                                    <div id="error_rol" class="invalid-feedback" v-if="erroresUsuario.rol">{{ erroresUsuario.rol }}</div>
                                </div>
                            </div>

                            <input id="usuarioId" type="hidden" asp-for="Id" v-model="usuario.id" aria-hidden="true"/>

                            <div class="row mb-2 mt-5 mt-md-4 justify-content-evenly align-items-end pt-3">
                                <div class="col-2 d-flex justify-content-center">
                                    <button type="submit" class="btn btn-primary d-block mx-auto" :class="{ disabled: estaCargando }" :disabled="estaCargando">Guardar</button>
                                </div>
                                <div class="col-2 d-flex justify-content-center">
                                    <button class="btn btn-secondary" type="button" @@click="limpiarFormulario">Limpiar</button>
                                </div>
                                <div class="col-2 d-flex justify-content-center">
                                    <button class="btn btn-outline-danger" type="button" data-bs-dismiss="modal">Cancelar</button>
                                </div>
                            </div>
                        </form>

                    </div>
                </div>
            </div>
            <div class="d-flex justify-content-start align-items-center border-top p-3">
                <span>Los campos con <span class="text-danger">*</span> son obligatorios.</span>
            </div>
        </div>
    </div>
</div>