@using System.Text.Json
@using metalurgicaMVC.ViewModels.UsuarioViewModels
@model IEnumerable<UsuarioVM>
@{
    ViewData["Title"] = "Usuarios";
    int cantidadPaginas = ViewBag.cantPag;
    int pagina = ViewBag.pagina;
    int paginaAnterior = pagina - 1;
    int paginaSiguiente = pagina + 1;
    int limit = ViewBag.cantidadPaginado;
    string busqueda = ViewBag.username ?? string.Empty;
    string mensajeEliminar = "el Usuario";
    var serializationOptions = new JsonSerializerOptions {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase
    };
    bool hayMensajeError = !string.IsNullOrWhiteSpace(ViewBag.MensajeError);
}

<div id="app-usuarios" class="container-fluid bg-light-subtle position-relative" v-cloak>
    <h1 class="text-center display-4">Usuarios</h1>

    <div class="row">
       <div class="col-6">
            <form id="form_buscador" class="position-relative needs-validation" @@submit.prevent="onSubmitBusqueda">
                <label for="buscador" class="form-label fw-bold">Buscar Usuario</label>
                <div class="input-group has-validation mb-3">
                    <input 
                        type="text" 
                        id="buscador" 
                        v-model="busqueda" 
                        class="form-control" 
                        :class="{ 'is-invalid': errorBusqueda }"
                        placeholder="escriba un nombre de usuario" 
                        value="@busqueda"
                    >
                    <span class="input-group-text" id="limpiar" style="cursor: pointer;" @@click="limpiar">
                        <i class="bi bi-x-lg" data-bs-toggle="tooltip" data-bs-title="Limpiar"></i>
                    </span>
                    <div id="error_form_buscador" class="invalid-tooltip" v-if="errorBusqueda">{{ errorBusqueda }}</div>
                    <button type="submit" class="btn btn-primary" :disabled="estaCargando" role="button">
                        <i class="bi bi-search"></i>
                        Buscar
                    </button>
                </div>
            </form>
        </div>
        <div class="col d-flex justify-content-end align-items-center mt-3 me-5">
            <button class="btn btn-outline-dark" @@click="pedirUsuarios(1)">
                <i class="bi bi-arrow-clockwise"></i>
                Recargar Todos
            </button>
        </div>
    </div>
    <div class="table-responsive my-2 rounded-3 fixed-height-table-container">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.Avatar).ToUpper()
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Username).ToUpper()
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Rol).ToUpper()
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Activo).ToUpper()
                    </th>
                    <th>ACCIONES</th>
                </tr>
            </thead>
            <tbody id="cuerpo">
                <tr :id="u.id" v-for="u in usuarios" :key="u.id">
                    <td class="align-middle py-0 ps-2">
                        <img :src="u.avatar" alt="foto perfil usuario" width="32" class="rounded-circle">
                    </td>
                    <td class="align-middle py-0 ps-2"> {{ u.username }} </td>
                    <td class="align-middle py-0 ps-2"> {{ u.rol }} </td>
                    <td class="align-middle py-0 ps-2"> {{ u.activo ? "activo" : "inactivo" }} </td>
                    <td>
                        <div class="d-flex justify-content-evenly align-items-center">
                            <a class="icon-enlace" :href="`Usuario/Edit/${u.id}`">
                                <i 
                                    :data-user-id="u.id" 
                                    class="bi bi-pencil-square fs-3 text-primary icon-hover" 
                                    style="cursor: pointer;"
                                    data-bs-toggle="tooltip" data-bs-title="Editar"
                                ></i>
                            </a>
                            <i 
                                :data-user-id="u.id" 
                                class="bi bi-trash fs-3 text-danger icon-hover" 
                                style="cursor: pointer;" 
                                @@click="abrirModalEliminar(u.id)" 
                                data-bs-toggle="tooltip" data-bs-title="Eliminar"
                            ></i>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
    <nav id="nav" class="border-top pt-3">
        <ul id="paginador" class="pagination justify-content-center">
            <li id="flecha-pag-izq" class="page-item" :class="{ disabled: esPrimeraPagina }" data-bs-toggle="tooltip" data-bs-title="Anterior" style="cursor: pointer;">
                <span @@click="pedirUsuarios(paginaAnterior)" class="page-link"><span>&laquo;</span></span>
            </li>
            <li class="page-item" v-for="p in cantidadPaginas" style="cursor: pointer;">
                <a  @@click="pedirUsuarios(p)" class="page-link" :class="{ active: p == paginaActual, disabled: cantidadPaginas == 1 }">{{ p }}</a>
            </li>
            <li id="flecha-pag-der" class="page-item" :class="{ disabled: esUltimaPagina }" data-bs-toggle="tooltip" data-bs-title="Siguiente" style="cursor: pointer;">
                <span @@click="pedirUsuarios(paginaSiguiente)" class="page-link"><span>&raquo;</span></span>
            </li>
        </ul>
    </nav>
    <div id="btn_add" class="position-absolute end-0 me-5" style="cursor: pointer; bottom: -12px">
        <i 
            class="bi bi-plus-square fs-1 text-primary icon-hover d-inline-block" 
            data-bs-toggle="tooltip" data-bs-title="Registrar Nuevo" 
            @@click="abrirFormModal"
        ></i>
    </div>

    <partial name="_ModalEliminar" model="mensajeEliminar"/>
    <partial name="_FormModal" model="new UsuarioVM()"/>
    <partial name="_ModalMensaje"/>
</div>


@section Scripts {
    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
    <script>

        document.addEventListener("DOMContentLoaded", _ => {
            const { createApp } = Vue;
            let modalEliminar;
            let formModal;
            const usuarioDefault = { id: 0, username: null, password: null, rol: "", avatar: null };
            const erroresUsuarioDefault = { username: null, password: null, rol: null };
            createApp({
                data() {
                    return {
                        usuarios: @Html.Raw(JsonSerializer.Serialize(Model, serializationOptions)),
                        urlBase: "api/usuarios",
                        opcionesFetch: { 
                            method: "POST",
                            headers: { 
                                'Content-Type': 'application/json'
                            },
                            body: null
                        },
                        limit: @limit,
                        paginaActual: @pagina,
                        busqueda: "@busqueda",
                        errorBusqueda: null,
                        cantidadPaginas: @cantidadPaginas,
                        paginaSiguiente: @paginaSiguiente,
                        paginaAnterior: @paginaAnterior,
                        esPrimeraPagina: @(paginaAnterior == 0 ? "true" : "false"),
                        esUltimaPagina: @(paginaSiguiente > cantidadPaginas ? "true" : "false"),
                        estaCargando: false,
                        hayUsuarios: @(Model.Count() > 0 ? "true" : "false"),
                        usuarioIdEliminar: 0,
                        usuario: { ...usuarioDefault },
                        erroresUsuario: { ...erroresUsuarioDefault },
                        mensaje: "",
                        esMensajeError: false,
                        mostrarPassword: false,
                        passwordInputType: "password",
                        passwordTooltip: "Mostrar Contraseña"
                    }
                },
                methods: {
                    async pedirUsuarios(page) {
                        if (page <= 0 || page > this.cantidadPaginas)
                            return;
                        let url = `${this.urlBase}?Limit=${this.limit}&Pagina=${page}`;
                        if (this.busqueda.length > 0)
                            url += `&Username=${this.busqueda}`;
                        this.estaCargando = true;
                        const data = await this.hacerPeticion(url);
                        this.estaCargando = false;
                        if (data) {
                            this.actualizarDOM(data, page);
                        }
                    },
                    async onSubmitBusqueda() {
                        this.errorBusqueda = null;
                        if (!this.busqueda) 
                            return;
                        if (this.busqueda.trim() == "") 
                            return;
                        if (this.busqueda.length > 25) {
                            this.errorBusqueda = "Valor de búsqueda muy largo";
                            return;
                        }
                        let url = `${this.urlBase}?Limit=${this.limit}&Pagina=1&Username=${this.busqueda}`;
                        this.estaCargando = true;
                        const data = await this.hacerPeticion(url);
                        this.estaCargando = false;
                        if (data) {
                            this.actualizarDOM(data, 1);
                        }
                    },
                    async hacerPeticion(url) {
                        try{
                            const response = await fetch(url);
                            if (response.ok) {
                                return await response.json();
                            } else {
                                const { mensaje, errors } = await response.json();
                                if (mensaje) {
                                    this.mostrarMensaje(mensaje, false);
                                }
                                if (errors) {
                                    mensaje = "";
                                    Object.keys(errors).forEach((e, i) => {
                                        mensaje += `${e}: ${errors[e].join(", ")}`;
                                        if (i < errors.length-1)
                                            mensaje += " - ";
                                    });
                                }
                                return null;
                            }
                        }
                        catch {
                            this.mostrarMensaje("Se produjo un error al hacer la petición", false);
                        }
                    },
                    actualizarDOM(data, page) {
                        this.usuarios = data.usuarios;
                        this.hayUsuarios = this.usuarios.length > 0;
                        this.cantidadPaginas = data.cantidadPaginas;
                        this.paginaActual = page;
                        this.paginaAnterior = page - 1;
                        this.paginaSiguiente = page + 1;
                        this.esPrimeraPagina = this.paginaAnterior == 0;
                        this.esUltimaPagina = this.paginaSiguiente > this.cantidadPaginas;
                    },
                    limpiar() {
                        this.busqueda = "";
                        this.errorBusqueda = null;
                    },
                    abrirModalEliminar(id) {
                        this.usuarioIdEliminar = id;
                        if (!modalEliminar)
                            modalEliminar = new bootstrap.Modal(document.getElementById('modal-eliminar'), {});
                        modalEliminar.show();
                    },
                    async eliminar() {
                        if (this.usuarioIdEliminar > 0) {
                            try {
                                const response = await fetch(`${this.urlBase}/${this.usuarioIdEliminar}`, { method: "DELETE" });
                                if (response.ok) {
                                    let url = `${this.urlBase}?Limit=${this.limit}&Pagina=${this.paginaActual}`;
                                    if (this.busqueda.length > 0)
                                        url += `&Username=${this.busqueda}`;
                                    this.estaCargando = true;
                                    const data = await this.hacerPeticion(url);
                                    this.estaCargando = false;
                                    if (data) {
                                        this.actualizarDOM(data, this.paginaActual);
                                    }
                                    this.mostrarMensaje("Usuarios eliminado");
                                } else {
                                    const { mensaje } = await response.json();
                                    this.mostrarMensaje(mensaje, false);
                                }
                            }
                            catch {
                                this.mostrarMensaje("Se produjo un error al hacer la petición", false);
                            }

                            if (modalEliminar)
                                modalEliminar.hide();
                        }
                    },
                    abrirFormModal() {
                        this.usuario = { ...usuarioDefault };
                        this.erroresUsuario = { ...erroresUsuarioDefault };
                        this.ocultarPassswordFn();
                        if (!formModal)
                            formModal = new bootstrap.Modal(document.getElementById('modal_formulario_usuario'), {});
                        formModal.show();
                    },
                    async onSubmitUsuario() {
                        this.estaCargando = true;
                        if (this.esFormularioValido()) {
                            this.opcionesFetch.body = JSON.stringify(this.usuario);
                            this.opcionesFetch.headers['RequestVerificationToken'] = document.getElementsByName("__RequestVerificationToken")?.item(0)?.value;
                            try{
                                const response = await fetch(this.urlBase, this.opcionesFetch);
                                if (response.ok) {
                                    const data = await response.json();
                                    if (this.usuarios.length < this.limit) 
                                        this.usuarios.push(data?.usuario);
                                    else if (this.esUltimaPagina) {
                                        this.cantidadPaginas++;
                                        this.esUltimaPagina = false;
                                    }
                                    if (formModal)
                                        formModal.hide();
                                    this.mostrarMensaje("Usuario Registrado");
                                } else {
                                    const { mensaje, errors } = await response.json();
                                    if (errors) {
                                        Object.keys(errors).forEach(e => {
                                            this.erroresUsuario[e.toLowerCase()] = errors[e].join(", ");
                                        });
                                    } else {
                                        this.mostrarMensaje(mensaje ?? "La petición no es correcta", false);
                                    }
                                }
                            } catch {
                                this.mostrarMensaje("Se produjo un error al hacer la petición", false);
                            }
                        }
                        this.estaCargando = false;
                    },
                    esFormularioValido() {
                        const mapaValidador = new Map([
                            ["username", validarUsername],
                            ["password", validarPassword],
                            ["rol", validarRol]
                        ]);
                        Object.keys(this.usuario)
                            .forEach(key => {
                                if (key == "id" || key == "avatar")
                                    return;
                                this.erroresUsuario[key] = mapaValidador.get(key)(this.usuario[key]);
                            }
                        );
                        return !Object.keys(this.erroresUsuario).some(v => this.erroresUsuario[v]);
                    },
                    limpiarFormulario() {
                        this.usuario = { ...usuarioDefault };
                        this.erroresUsuario = { ...erroresUsuarioDefault };
                        this.passwordInputType = "password";
                    },
                    mostrarMensaje(mensaje, ok = true) {
                        this.mensaje = mensaje;
                        this.esMensajeError = !ok;
                        const myModal = new bootstrap.Modal(document.getElementById('modal-mensaje'), {});
                        myModal.show();
                    },
                    mostrarOcultarPasssword() {
                        this.mostrarPassword = !this.mostrarPassword;
                        if (this.mostrarPassword) {
                            this.mostrarPasswordFn();
                        }
                        else {
                            this.ocultarPassswordFn();
                        }
                    },
                    mostrarPasswordFn() {
                        this.passwordInputType = "text";
                        this.passwordTooltip = "Ocultar Contraseña";
                        tooltipList[tooltipList.findIndex(t => t._element.id == "i-password")].setContent({ '.tooltip-inner': this.passwordTooltip });
                    },
                    ocultarPassswordFn() {
                        this.mostrarPassword = false;
                        this.passwordInputType = "password";
                        this.passwordTooltip = "Mostrar Contraseña";
                        tooltipList[tooltipList.findIndex(t => t._element.id == "i-password")].setContent({ '.tooltip-inner': this.passwordTooltip });
                    }
                },
                mounted() {
                    if (@(hayMensajeError.ToString().ToLower())) {
                        this.mostrarMensaje("@ViewBag.MensajeError", false);
                    }
                    @* this.abrirFormModal(); *@
                }
            }).mount('#app-usuarios');
            const tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]');
            const tooltipList = [...tooltipTriggerList].map(tooltipTriggerEl => new bootstrap.Tooltip(tooltipTriggerEl));
        });

        function validarUsername(cadena) {
            if (!cadena)
                return "El nombre de usuario es obligatorio";
            if (cadena.trim().length == 0)
                return "El nombre de usuario es obligatorio";
            if (cadena.length > 20)
                return "El máximo de carateres permitidos es 20";
            return;
        }

        function validarRol(valor) {
            if (!valor)
                return "El rol es obligatorio";
            return;
        }

        function validarPassword(valor) {
            if (!valor)
                return "La cantraseña es obligatoria";
            if (valor.trim().length == 0)
                return "La cantraseña es obligatoria";
            if (valor.trim().length < 8)
                return "La cantraseña debe tener al menos 8 caracteres";
            return;
        }
    </script>
}