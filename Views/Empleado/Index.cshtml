@using System.Text.Json
@using metalurgicaMVC.ViewModels
@model IEnumerable<EmpleadoVM>
@{
    ViewData["Title"] = "Empleados";
    int cantidadPaginas = ViewBag.cantPag;
    int pagina = ViewBag.pagina;
    int paginaAnterior = pagina - 1;
    int paginaSiguiente = pagina + 1;
    int limit = ViewBag.cantidadPaginado;
    string busqueda = ViewBag.busqueda ?? string.Empty;
    string mensajeEliminar = "el Empleado";
    var serializationOptions = new JsonSerializerOptions {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase
    };
    bool hayMensajeError = !string.IsNullOrWhiteSpace(ViewBag.MensajeError);
}

<div id="app-empleados" class="container-fluid bg-light-subtle position-relative" v-cloak>
    <h1 class="text-center display-4">Empleados</h1>

    <div class="row">
       <div class="col-6">
            <form id="form_buscador" class="position-relative needs-validation" @@submit.prevent="onSubmit">
                <label for="buscador" class="form-label fw-bold">Buscar Empleado</label>
                <div class="input-group has-validation mb-3">
                    <input 
                        type="text" 
                        id="buscador" 
                        v-model="busqueda" 
                        class="form-control" 
                        :class="{ 'is-invalid': errorBusqueda }" 
                        placeholder="nombre o apellido del empleado" 
                        value="@busqueda"
                    >
                    <span class="input-group-text" id="limpiar" style="cursor: pointer;" @@click="limpiar">
                        <i class="bi bi-x-lg" data-bs-toggle="tooltip" data-bs-title="Limpiar Búsqueda"></i>
                    </span>
                    <div id="error_form_buscador" class="invalid-tooltip" v-if="errorBusqueda">{{ errorBusqueda }}</div>
                    <button type="submit" class="btn btn-primary" :disabled="estaCargando">
                        <i class="bi bi-search"></i>
                        Buscar
                    </button>
                </div>
            </form>
        </div>
        <div class="col d-flex justify-content-end align-items-center mt-3 me-5">
            <button class="btn btn-outline-dark" @@click="recargar">
                <i class="bi bi-arrow-clockwise"></i>
                Recargar Todos
            </button>
        </div>
    </div>
    <div class="table-responsive my-2 rounded-3 fixed-height-table-container">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th colspan="2">
                        @Html.DisplayNameFor(model => model.Nombre).ToUpper()
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Seccion).ToUpper()
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.FechaContratado).ToUpper()
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Activo).ToUpper()
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Telefono).ToUpper()
                    </th>
                    <th>ACCIONES</th>
                </tr>
            </thead>
            <tbody id="cuerpo">
                <tr :id="e.id" v-for="e in empleados" :key="e.id">
                    <td class="align-middle py-0 ps-2" colspan="2"> {{ fullName(e) }} </td>
                    <td class="align-middle py-0 ps-2"> {{ e.seccion }} </td>
                    <td class="align-middle py-0 ps-2"> {{ toLocalDate(e) }} </td>
                    <td class="align-middle py-0 ps-2"> {{ isActive(e) }} </td>
                    <td class="align-middle py-0 ps-2"> {{ e.telefono }} </td>
                    <td>
                        <div class="d-flex justify-content-evenly align-items-center">
                            <i 
                                :data-empleado-id="e.id" 
                                class="bi bi-pencil-square fs-3 text-primary icon-hover" 
                                style="cursor: pointer;" 
                                @@click="abrirFormModal(e)" 
                                data-bs-toggle="tooltip" data-bs-title="Editar"
                            ></i>
                            <i 
                                :data-empleado-id="e.id" 
                                class="bi bi-trash fs-3 text-danger icon-hover" 
                                style="cursor: pointer;" 
                                @@click="abrirModalEliminar(e.id)" 
                                data-bs-toggle="tooltip" data-bs-title="Eliminar"
                            ></i>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
    <nav id="nav" class="border-top pt-3">
        <ul id="paginador" class="pagination justify-content-center">
            <li id="flecha-pag-izq" class="page-item" :class="{ disabled: esPrimeraPagina }" data-bs-toggle="tooltip" data-bs-title="Anterior" style="cursor: pointer;">
                <span @@click="pedirEmpleados(paginaAnterior)" class="page-link"><span>&laquo;</span></span>
            </li>
            <li class="page-item" v-for="p in cantidadPaginas" style="cursor: pointer;">
                <a  @@click="pedirEmpleados(p)" class="page-link" :class="{ active: p == paginaActual, disabled: cantidadPaginas == 1 }">{{ p }}</a>
            </li>
            <li id="flecha-pag-der" class="page-item" :class="{ disabled: esUltimaPagina }" data-bs-toggle="tooltip" data-bs-title="Siguiente" style="cursor: pointer;">
                <span @@click="pedirEmpleados(paginaSiguiente)" class="page-link"><span>&raquo;</span></span>
            </li>
        </ul>
    </nav>
    <div id="btn_add" class="position-absolute end-0 me-5" style="cursor: pointer; bottom: -12px">
        <i 
            class="bi bi-plus-square fs-1 text-primary icon-hover d-inline-block" 
            data-bs-toggle="tooltip" data-bs-title="Registrar Nuevo" 
            @@click="abrirFormModal"
        ></i>
    </div>

    <partial name="_ModalEliminar" model="mensajeEliminar"/>
    <partial name="_FormModal" model="new EmpleadoVM()"/>
    <partial name="_ModalMensaje"/>
</div>

@section Scripts {
    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", _ => {
            const { createApp } = Vue;
            let modalEliminar;
            let formModal;
            const empleadoPorDefecto = { id: 0, nombre: null, apellido: null, telefono: null, seccion: null, fechaContratado: null, sueldo: null };
            const erroresEmpleadoDefault = { nombre: null, apellido: null, telefono: null, seccion: null, fechaContratado: null, sueldo: null };
            createApp({
                data() {
                    return {
                        empleados: @Html.Raw(JsonSerializer.Serialize(Model, serializationOptions)),
                        urlBase: "api/empleados",
                        limit: @limit,
                        paginaActual: @pagina,
                        busqueda: "@busqueda",
                        errorBusqueda: null,
                        cantidadPaginas: @cantidadPaginas,
                        paginaSiguiente: @paginaSiguiente,
                        paginaAnterior: @paginaAnterior,
                        esPrimeraPagina: @(paginaAnterior == 0 ? "true" : "false"),
                        esUltimaPagina: @(paginaSiguiente > cantidadPaginas ? "true" : "false"),
                        estaCargando: false,
                        hayEmpleados: @(Model.Count() > 0 ? "true" : "false"),
                        empleadoIdEliminar: 0,
                        empleado: { ...empleadoPorDefecto },
                        erroresEmpleado: { ...erroresEmpleadoDefault },
                        estaEditando: false,
                        mensaje: "",
                        esMensajeError: false,
                        tooltipTriggerList: [],
                        tooltipList: []
                    }
                },
                methods: {
                    async pedirEmpleados(page) {
                        if (page <= 0 || page > this.cantidadPaginas)
                            return;
                        let url = `${this.urlBase}?Limit=${this.limit}&Pagina=${page}`;
                        if (this.busqueda.length > 0)
                            url += `&Busqueda=${this.busqueda}`;
                        this.estaCargando = true;
                        const data = await this.hacerPeticion(url);
                        this.estaCargando = false;
                        if (data) {
                            this.actualizarDOM(data, page);
                        }
                    },
                    async hacerPeticion(url) {
                        try{
                            const response = await fetch(url);
                            if (response.ok) {
                                return await response.json();
                            } else {
                                const { mensaje, errors } = await response.json();
                                if (mensaje) {
                                    this.mostrarMensaje(mensaje, false);
                                }
                                if (errors) {
                                    mensaje = "";
                                    Object.keys(errors).forEach((e, i) => {
                                        mensaje += `${e}: ${errors[e].join(", ")}`;
                                        if (i < errors.length-1)
                                            mensaje += " - ";
                                    });
                                }
                                return null;
                            }
                        }
                        catch {
                            this.mostrarMensaje("Error al traer los empleados", false);
                        }
                    },
                    actualizarDOM(data, page) {
                        this.empleados = data.empleados;
                        this.hayEmpleados = this.empleados.length > 0;
                        this.cantidadPaginas = data.cantidadPaginas;
                        this.paginaActual = page;
                        this.paginaAnterior = page - 1;
                        this.paginaSiguiente = page + 1;
                        this.esPrimeraPagina = this.paginaAnterior == 0;
                        this.esUltimaPagina = this.paginaSiguiente > this.cantidadPaginas;
                        setTimeout(() => { this.inicializarTooltips(); }, 2000);
                    },
                    mostrarMensaje(mensaje, ok = true) {
                        this.mensaje = mensaje;
                        this.esMensajeError = !ok;
                        const myModal = new bootstrap.Modal(document.getElementById('modal-mensaje'), {});
                        myModal.show();
                    },
                    async onSubmit() {
                        if (this.busqueda === undefined || this.busqueda === null) 
                            return;
                        if (this.busqueda.trim() == "") 
                            return;
                        if (this.busqueda.length > 25) {
                            this.errorBusqueda = "Valor de búsqueda muy largo";
                            return;
                        }
                        this.errorBusqueda = null;
                        let url = `${this.urlBase}?Limit=${this.limit}&Pagina=1&Busqueda=${this.busqueda}`;
                        this.estaCargando = true;
                        const data = await this.hacerPeticion(url);
                        this.estaCargando = false;
                        if (data) {
                            this.actualizarDOM(data, 1);
                        }
                    },
                    limpiar() {
                        this.busqueda = "";
                        this.errorBusqueda = null;
                    },
                    recargar() {
                        this.limpiar();
                        this.pedirEmpleados(1);
                    },
                    abrirModalEliminar(id) {
                        this.empleadoIdEliminar = id;
                        if (modalEliminar  == undefined)
                            modalEliminar = new bootstrap.Modal(document.getElementById('modal-eliminar'), {});
                        modalEliminar.show();
                    },
                    async eliminar() {
                        if (this.empleadoIdEliminar > 0) {
                            this.estaCargando = true;
                            try {
                                const response = await fetch(`${this.urlBase}/${this.empleadoIdEliminar}`, { method: "DELETE" });
                                if (response.ok) {
                                    let url = `${this.urlBase}?Limit=${this.limit}&Pagina=${this.paginaActual}`;
                                    if (this.busqueda.length > 0)
                                        url += `&Busqueda=${this.busqueda}`;
                                    const data = await this.hacerPeticion(url);
                                    if (data) {
                                        this.actualizarDOM(data, this.paginaActual);
                                    }
                                    this.mostrarMensaje("Empleado eliminado");
                                } else {
                                    const { mensaje } = await response.json();
                                    this.mostrarMensaje(mensaje, false);
                                }
                            }
                            catch {
                                this.mostrarMensaje("Error al eliminar el empleado", false);
                            }
                            this.estaCargando = false;

                            if (modalEliminar != undefined)
                                modalEliminar.hide();
                        }
                    },
                    abrirFormModal(empleado) {
                        if (empleado instanceof Event) {
                            this.empleado = { ...empleadoPorDefecto };
                        }
                        else {
                            this.empleado = { ...empleado };
                            this.empleado.fechaContratado = this.empleado.fechaContratado.split("T")[0];
                            this.estaEditando = true;
                        }
                        this.erroresEmpleado = { ...erroresEmpleadoDefault };
                        if (formModal == undefined)
                            formModal = new bootstrap.Modal(document.getElementById('modal_formulario_empleado'), {});
                        formModal.show();
                    },
                    cancelarEditar() {
                        this.estaEditando = false;
                    },
                    async onSubmitEmpleado() {
                        if (this.esFormularioValido()) {
                            this.estaCargando = true;
                            let url = this.urlBase;
                            const opcionesFetch = { 
                                method: "POST",
                                headers: { 
                                    'Content-Type': 'application/json',
                                    'RequestVerificationToken': document.getElementsByName("__RequestVerificationToken")?.item(0)?.value
                                },
                                body: JSON.stringify(this.empleado)
                            };
                            if (this.estaEditando) {
                                url += `/${this.empleado.id}`;
                                opcionesFetch.method = "PUT";
                            }
                            try{
                                const response = await fetch(url, opcionesFetch);
                                if (response.ok) {
                                    const data = await response.json();
                                    if (this.estaEditando) {
                                        const indiceEmpleadoActualizado = this.empleados.findIndex(e => e.id == data?.empleado.id);
                                        if (indiceEmpleadoActualizado >= 0) {
                                            this.empleados[indiceEmpleadoActualizado] = data?.empleado;
                                        }
                                    } else {
                                        @* if (this.empleados.length < this.limit) 
                                            this.empleados.push(data?.empleado);
                                        else if (this.esUltimaPagina) {
                                            this.cantidadPaginas++;
                                            this.esUltimaPagina = false;
                                        } *@
                                        url = `${this.urlBase}?Limit=${this.limit}&Pagina=${this.paginaActual}`;
                                        if (this.busqueda.length > 0)
                                            url += `&Busqueda=${this.busqueda}`;
                                        const data = await this.hacerPeticion(url);
                                        if (data) {
                                            this.actualizarDOM(data, this.paginaActual);
                                        }
                                    }
                                    if (formModal != undefined){
                                        formModal.hide();
                                    }
                                    this.mostrarMensaje(`Empleado ${this.estaEditando ? "Actualizado" : "Registrado" }`);
                                } else {
                                    const { mensaje, errors } = await response.json();
                                    if (errors) {
                                        Object.keys(errors).forEach(e => {
                                            if (e == "FechaContratado")
                                                this.erroresEmpleado[e[0].toLowerCase()+e.substring(1)] = errors[e].join(", ");
                                            else 
                                                this.erroresEmpleado[e.toLowerCase()] = errors[e].join(", ");
                                        });
                                    } else {
                                        this.mostrarMensaje(mensaje ?? "La petición no es correcta", false);
                                    }
                                }
                            } catch {
                                this.mostrarMensaje(`Se produjo un error al ${this.estaEditando ? "Actualizar" : "Registrar" }`, false);
                            }
                            this.estaCargando = false;
                        }
                        this.estaEditando = false;
                    },
                    esFormularioValido() {
                        const mapaValidador = new Map([
                            ["nombre", validarNombreApellido],
                            ["apellido", validarNombreApellido],
                            ["seccion", validarSeccion],
                            ["sueldo", validarSueldo],
                            ["fechaContratado", validarFechaContratado],
                            ["telefono", validarTelefono]
                        ]);
                        Object.keys(this.empleado)
                            .forEach(key => {
                                if (key == "id" || key == "fechaFin" || key == "activo") return;
                                this.erroresEmpleado[key] = mapaValidador.get(key)(this.empleado[key]);
                            }
                        );
                        return !Object.keys(this.erroresEmpleado).some(v => this.erroresEmpleado[v]);
                    },
                    limpiarFormulario() {
                        this.empleado = { ...empleadoPorDefecto };
                        this.erroresEmpleado = { ...erroresEmpleadoDefault };
                    },
                    fullName(e) {
                        return `${e.apellido}, ${e.nombre}`;
                    },
                    isActive(e) {
                        return e.activo ? "✔" : "❌";
                    },
                    toLocalDate(e) {
                        const fecha = new Date(e.fechaContratado);
                        return fecha?.toLocaleDateString() ?? " - ";
                    },
                    inicializarTooltips() {
                        this.tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]');
                        this.tooltipList = [...this.tooltipTriggerList].map(tooltipTriggerEl => new bootstrap.Tooltip(tooltipTriggerEl));
                    }
                },
                mounted() {
                    if (@(hayMensajeError.ToString().ToLower())) {
                        this.mostrarMensaje("@ViewBag.MensajeError", false);
                    }
                    this.inicializarTooltips();
                }
            }).mount("#app-empleados");
        });

        function validarSeccion(valor) {
            if (!valor || valor.trim().length == 0) 
                return "La sección es obligatoria";
            return;
        }

        function validarNombreApellido(valor) {
            if (!valor) return "El campo es requerido";
            if (typeof valor !== "string") return "El campo de ser de texto";
            if (valor.trim() === "") return "El campo es requerido";
            if (valor.length > 100) return "El máximo de caracteres de de 100";
            return;
        }

        function validarTelefono(valor) {
            if (!valor || valor.trim().length == 0) return "El teléfono es requerido";
            if (valor.length > 20) return "El máximo de caracteres de de 20.";
            const regExp = /^\+?[0-9\s\-]{6,20}$/;
            if (!regExp.test(valor)) return "El teléfono tiene caractares inválidos";
            return;
        }

        function validarFechaContratado(valor) {
            if (!valor || valor.trim().length === 0) 
                return "La fecha de contratación es requerida";
            return;
        }

        function validarSueldo(valor) {
            if (!valor) 
                return "El sueldo es obligatorio";
            if (isNaN(valor)) 
                return "El sueldo debe ser un número";
            if (valor <= 0) 
                return "El sueldo debe ser mayor que 0";
            return;
        }
    </script>
}